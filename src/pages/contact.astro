---
import BaseLayout from "../layouts/BaseLayout.astro";

const CONTACT_EMAIL = "gautham@growthtodo.com";
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout sideBarActiveItemID="contact" title="Contact">

  <section class="py-4 md:py-20 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10 md:min-h-screen md:flex md:flex-col md:justify-center">
    <div class="space-y-3 md:space-y-8 max-w-2xl">

      <h1 class="font-serif text-xl md:text-3xl font-normal leading-snug tracking-tight text-base-content/80">
        Get in <span class="text-teal-600 font-normal">touch.</span>
      </h1>

      <p class="font-serif text-base md:text-xl leading-snug text-base-content/70">
        The best way to reach me is email.
      </p>

      <button
        type="button"
        id="contact-copy-btn"
        data-email={CONTACT_EMAIL}
        class="inline-flex items-center gap-3 font-sans text-base md:text-lg rounded-lg border border-base-300 px-5 py-3 text-base-content hover:bg-base-300/30 transition-all duration-200"
      >
        <span>{CONTACT_EMAIL}</span>
        <span id="contact-copy-label" class="text-sm text-base-content/50 border-l border-base-300 pl-3">Copy</span>
      </button>

    </div>
  </section>

</BaseLayout>
</div>

<script>
  const contactBtn = document.getElementById("contact-copy-btn");
  const contactLabel = document.getElementById("contact-copy-label");
  if (contactBtn && contactLabel) {
    const email = contactBtn.dataset.email;
    contactBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = email;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        document.body.removeChild(textarea);
      }
      contactLabel.textContent = "Copied!";
      setTimeout(() => {
        contactLabel.textContent = "Copy";
      }, 1500);
    });
  }
</script>
