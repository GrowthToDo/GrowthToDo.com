---
import BaseLayout from "../layouts/BaseLayout.astro";

const BOOK_CALL_LINK = "https://growthtodo.neetocal.com/30mins";
const BLOG_PAGE = "/blog";
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout sideBarActiveItemID="home">
  <!-- HERO -->
  <section class="py-8 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-dashed border-base-content/10 min-h-screen flex flex-col justify-center">
    <div class="space-y-5 max-w-5xl">
      <div class="inline-block border border-base-content/10 px-3 py-1.5">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/70">GROWTHTODO</span>
      </div>

      <h1 class="font-serif text-5xl md:text-7xl font-bold leading-[0.85] tracking-tight text-base-content">
        Too many <span class="italic font-light">directions.</span><br/>
        Not enough <span class="italic font-light">clarity.</span><br/>
        Let's fix that.
      </h1>

      <div class="space-y-3 max-w-3xl">
        <p class="font-serif text-xl md:text-2xl text-base-content/70 leading-relaxed">
          You're building something real. SaaS, D2C, education, info-products. But you're stuck. Overwhelmed. Unsure what to do next.
        </p>

        <p class="font-serif text-xl md:text-2xl text-base-content/90 leading-relaxed">
          I help founders cut through noise, generate clarity, and turn it into a sequenced to-do list that actually grows the company.
        </p>
      </div>

      <div class="flex flex-wrap gap-4 pt-1">
        <a
          class="group inline-block px-8 py-4 bg-base-content text-base-100 font-mono text-sm uppercase tracking-[0.2em] border border-base-content shadow-[4px_4px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_#272048] transition-all duration-300"
          href={BOOK_CALL_LINK}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
          <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a
          class="inline-block px-8 py-4 bg-base-100 text-base-content font-mono text-sm uppercase tracking-[0.2em] border border-base-content shadow-[4px_4px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_#272048] transition-all duration-300"
          href="/consulting"
        >
          Learn more
        </a>
      </div>

      <p class="text-sm font-mono text-base-content/50 pt-1 tracking-[0.1em] leading-loose">
        FOR FOUNDERS BUILDING: SaaS, D2C, education, content, info-products
      </p>
    </div>
  </section>
</BaseLayout>
</div>
