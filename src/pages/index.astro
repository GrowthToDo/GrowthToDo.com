---
import BaseLayout from "../layouts/BaseLayout.astro";

const BOOK_CALL_LINK = "https://growthtodo.neetocal.com/30mins";
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout sideBarActiveItemID="home">

  <section class="py-12 md:py-20 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10 min-h-screen flex flex-col justify-center">
    <div class="space-y-8 max-w-2xl">

      <h1 class="font-serif text-5xl md:text-6xl font-bold leading-tight tracking-tight text-base-content">
        Hi, I'm <span class="text-teal-600 font-normal">Gautham.</span>
      </h1>

      <p class="font-serif text-xl text-base-content/70 leading-relaxed">
        I build internet-first businesses in education, software and marketing domains. Been at it since 2013. Still learning.
      </p>

      <div class="space-y-3">
        <p class="font-serif text-xl text-base-content/70">What I'm focussed on right now:</p>
        <ul class="space-y-2 list-disc list-inside marker:text-teal-500 marker:text-lg">
          <li class="font-serif text-xl text-base-content">Helping businesses <a href="https://sellontube.com" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">acquire customers from YouTube</a></li>
          <li class="font-serif text-xl text-base-content">Building <a href="https://simplescheduleai.com" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">smarter scheduling for US hospitals</a></li>
          <li class="font-serif text-xl text-base-content">Teaching students to be <a href="https://theseconddesign.com/real-world-ready" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">world-class employees and world-beating entrepreneurs</a></li>
          <li class="font-serif text-xl text-base-content">Producing a show on <a href="https://shippingwith.ai/" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">transformational AI workflows</a></li>
        </ul>
        <a href="/work" class="inline-block font-sans text-sm text-base-content/50 hover:text-base-content transition-colors pt-1">See all →</a>
      </div>


<div class="flex flex-wrap gap-4 pt-2">
        <a
          class="group inline-block px-8 py-3.5 bg-base-content text-base-100 font-sans text-sm font-semibold rounded-lg hover:opacity-80 transition-opacity duration-200"
          href={BOOK_CALL_LINK}
          target="_blank"
          rel="noopener noreferrer"
        >
          Say hello
          <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a
          class="inline-block px-8 py-3.5 text-base-content font-sans text-sm font-semibold rounded-lg border-2 border-base-content/25 hover:border-base-content transition-colors duration-200"
          href="/cv"
        >
          More about me
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
</div>
