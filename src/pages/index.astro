---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import dayjs from "dayjs";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title="Writing" sideBarActiveItemID="blog">
  <section class="py-10 md:py-14 max-w-2xl mx-auto px-6 md:px-0">

    <h1 class="font-serif text-2xl md:text-3xl font-bold text-base-content mb-10">Notes from a founder-operator.</h1>

    <div class="space-y-3">
      {posts.map((post) => (
        <a
          href={"/blog/" + createSlug(post.data.title, post.slug)}
          class="group flex items-baseline gap-5"
        >
          <span class="font-sans text-sm text-base-content/35 tabular-nums flex-shrink-0">
            {dayjs(post.data.pubDate).format("YYYY · MM")}
          </span>
          <span class="font-serif text-base text-base-content group-hover:text-teal-600 transition-colors">{post.data.title}</span>
        </a>
      ))}
    </div>

    <div class="pt-10 border-t border-base-content/10 mt-10">
      <a href="/blog/right-to-dos-right-order-right-speed" class="font-serif text-sm text-base-content/60 hover:text-base-content/80 transition-colors">
        About the name <span class="italic font-bold">Growth To Do</span> →
      </a>
    </div>

  </section>
</BaseLayout>
</div>
