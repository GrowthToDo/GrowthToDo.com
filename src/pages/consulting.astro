---
import BaseLayout from "../layouts/BaseLayout.astro";

const BOOK_CALL_LINK = "https://growthtodo.neetocal.com/30mins";
const CONTACT_LINK = "mailto:gautham@growthtodo.com";

const engagements = [
  {
    title: "Clarity Sprint",
    badge: "START HERE",
    duration: "60-90 min",
    desc: "One working session. We diagnose what is actually stuck, cut through the noise, and build a sequenced action plan for the next 2-4 weeks.",
    outcome: "You leave with a prioritized to-do list you can execute immediately.",
  },
  {
    title: "PMF Deep Dive",
    badge: "WORKSHOP",
    duration: "90-120 min",
    desc: "For founders with unclear demand signals. We pressure test your ICP, offer, and distribution. You walk away with testable hypotheses and your next 3 experiments.",
    outcome: "A PMF scorecard and a clear path to validate or pivot.",
  },
  {
    title: "4-Week Execution",
    badge: "FOLLOW-UP",
    duration: "4 weeks",
    desc: "Weekly cadence to ship the plan with momentum. Planning, review, decision support, and accountability without theatre.",
    outcome: "The plan actually gets done. Momentum compounds.",
  },
];

const testimonials = [
  {
    name: "Abhishek Bose",
    title: "Founder",
    quote: "He can point out something in a 30-minute call that might take you a year to figure out on your own.",
  },
  {
    name: "Pradeep Pandey",
    title: "Product Builder",
    quote: "He transformed my approach to product development in 3 days. Scattered ideas became structured, actionable steps.",
  },
  {
    name: "Saishree Bandekar",
    title: "Founder, Purple Bakehouse",
    quote: "He helped me get to the root of my problems and made intimidating things feel learnable. The mindset shift in one hour was essential.",
  },
  {
    name: "Andre Schaffer",
    title: "First-time Founder",
    quote: "He helped me prioritize demand over infrastructure early. Saved months of unnecessary work and prevented wasted spend.",
  },
];

const steps = [
  { num: "01", title: "Share context", desc: "A short note on what you are building, current traction, and what feels stuck." },
  { num: "02", title: "Working session", desc: "We diagnose, challenge assumptions, and find the root cause together." },
  { num: "03", title: "Walk away with a plan", desc: "A prioritized, sequenced to-do list. Not a PDF. Something you can execute." },
];

const principles = [
  { label: "NO FLUFF", desc: "Zero motivational speak. Zero generic frameworks. Only decisions you can act on today." },
  { label: "NO THEATRE", desc: "No slide decks you will never open. You leave with artifacts: plans, scorecards, execution lists." },
  { label: "NO THEORY", desc: "Built from 15+ years shipping products, not case studies. Real scars, real patterns, real truth." },
];
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title="Consulting" sideBarActiveItemID="consulting">
  <!-- HERO -->
  <section class="py-12 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-dashed border-base-content/10">
    <div class="space-y-6 max-w-5xl">
      <div class="inline-block border border-base-content/10 px-3 py-1.5">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/70">CONSULTING</span>
      </div>

      <h1 class="font-serif text-5xl md:text-7xl font-bold leading-[0.85] tracking-tight text-base-content">
        Cut through <span class="italic font-light">the</span> chaos.
      </h1>

      <p class="font-serif text-xl md:text-2xl text-base-content/70 max-w-3xl leading-relaxed">
        You know the business. You know the market. But somewhere between strategy and execution, things get stuck. I help founders cut through noise and turn clarity into a sequenced to-do list that actually moves the needle.
      </p>

      <div class="flex flex-wrap gap-4 pt-6">
        <a
          class="group inline-block px-8 py-4 bg-base-content text-base-100 font-mono text-sm uppercase tracking-[0.2em] border border-base-content shadow-[4px_4px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_#272048] transition-all duration-300"
          href={BOOK_CALL_LINK}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
          <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a
          class="inline-block px-8 py-4 bg-base-100 text-base-content font-mono text-sm uppercase tracking-[0.2em] border border-base-content shadow-[4px_4px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_#272048] transition-all duration-300 underline-offset-4"
          href={CONTACT_LINK}
        >
          Ask a question
        </a>
      </div>

      <p class="text-sm font-mono text-base-content/50 pt-4 tracking-[0.1em] leading-loose">
        BEST FIT: SaaS, D2C, education, content, info-products<br/>
        NOT A FIT: offline businesses or fundraising intros
      </p>
    </div>
  </section>

  <!-- SPLIT COMPARISON - White/Beige Split -->
  <section class="grid md:grid-cols-2 gap-0 border-y border-dashed border-base-content/10">
    <div class="bg-white p-8 md:p-12 border-r border-base-content/10">
      <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-6">TRADITIONAL CONSULTING</div>
      <h3 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-base-content leading-tight">Theory and theatre</h3>
      <ul class="space-y-4 font-serif text-lg text-base-content/70">
        <li class="flex items-start gap-3">
          <span class="text-red-600 mt-1">×</span>
          <span>Generic frameworks copied from MBA textbooks</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-600 mt-1">×</span>
          <span>Slide decks you will never open again</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-600 mt-1">×</span>
          <span>High-level strategy with no execution plan</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-600 mt-1">×</span>
          <span>Expensive retainers with slow turnaround</span>
        </li>
      </ul>
    </div>
    <div class="bg-[#f9f9f7] p-8 md:p-12">
      <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-6">MY APPROACH</div>
      <h3 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-base-content leading-tight">Clarity and execution</h3>
      <ul class="space-y-4 font-serif text-lg text-base-content/70">
        <li class="flex items-start gap-3">
          <span class="text-green-600 mt-1">✓</span>
          <span>Built from shipping real products for 15+ years</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-green-600 mt-1">✓</span>
          <span>Actionable artifacts: plans, scorecards, experiments</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-green-600 mt-1">✓</span>
          <span>Sequenced to-do lists you can execute today</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-green-600 mt-1">✓</span>
          <span>Fast turnaround, no retainer lock-in</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- PRINCIPLES - Code-style callouts on beige -->
  <section class="bg-[#f0f0eb] py-12 md:py-12 border-b border-dashed border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-8">FIGURE 01: PRINCIPLES</div>
      <h2 class="font-serif text-5xl md:text-6xl font-bold mb-20 text-base-content leading-[0.85]">
        How I <span class="italic font-light">actually</span> work
      </h2>

      <div class="space-y-6 max-w-4xl">
        {principles.map((p, index) => (
          <div class="border-l-4 border-base-content bg-white p-8 font-mono text-sm leading-relaxed">
            <div class="text-xs uppercase tracking-[0.2em] text-base-content/50 mb-3">{p.label}</div>
            <div class="font-serif text-xl text-base-content/90">{p.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS - White Background with outer border frame -->
  <section class="py-12 md:py-12 border-x border-dashed border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-8">FIGURE 02: PROCESS</div>
      <h2 class="font-serif text-5xl md:text-6xl font-bold mb-20 text-base-content leading-[0.85]">How it works</h2>

      <div class="grid md:grid-cols-3 gap-0 border border-base-content/10">
        {steps.map((step, index) => (
          <div class="group border-r last:border-r-0 border-b md:border-b-0 border-base-content/10 p-10 md:p-12 min-h-[320px] bg-white hover:bg-base-content hover:text-white transition-all duration-500">
            <div class="font-mono text-xs uppercase tracking-[0.2em] text-current opacity-50 mb-6">{step.num}</div>
            <h3 class="font-serif text-3xl md:text-4xl font-bold mb-5 text-current leading-tight">{step.title}</h3>
            <p class="font-serif text-lg text-current opacity-80 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ENGAGEMENTS - Beige Background -->
  <section class="bg-[#f9f9f7] py-12 md:py-12 border-y border-dashed border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-8">FIGURE 03: ENGAGEMENT OPTIONS</div>
      <h2 class="font-serif text-5xl md:text-6xl font-bold mb-20 text-base-content leading-[0.85]">
        Ways to <span class="italic font-light">work</span> together
      </h2>

      <div class="border-t border-base-content/10">
        {engagements.map((e, index) => (
          <div class="group border-b border-base-content/10 py-12 md:py-12 px-0 md:px-10 hover:bg-base-content hover:text-white hover:-mx-10 hover:px-10 transition-all duration-500">
            <div class="space-y-5">
              <div class="flex flex-wrap items-center gap-4">
                <h3 class="font-serif text-4xl md:text-5xl font-bold text-current leading-tight">{e.title}</h3>
                <span class="font-mono text-xs uppercase tracking-[0.2em] px-3 py-2 bg-current text-white group-hover:bg-white group-hover:text-base-content transition-all">{e.badge}</span>
                <span class="font-mono text-xs text-current opacity-50 tracking-[0.15em]">{e.duration}</span>
              </div>

              <p class="font-serif text-xl md:text-2xl text-current opacity-80 leading-relaxed max-w-4xl">{e.desc}</p>

              <div class="pt-3 border-t border-current opacity-20 group-hover:opacity-30"></div>

              <div class="pt-2">
                <span class="font-mono text-xs uppercase tracking-[0.2em] text-current opacity-50">OUTCOME: </span>
                <span class="font-serif text-lg text-current opacity-90">{e.outcome}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p class="font-mono text-sm text-base-content/50 mt-16 tracking-[0.1em]">
        Not sure which fits? Book a call and I will point you to the right starting point.
      </p>
    </div>
  </section>

  <!-- MANIFESTO - Dark Section -->
  <section class="bg-[#272048] text-white py-12 md:py-12 border-y border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="border-l-4 border-white/40 pl-10 max-w-5xl">
        <div class="font-mono text-xs uppercase tracking-[0.2em] text-white/50 mb-8">WHY THIS MATTERS</div>
        <blockquote class="font-serif text-4xl md:text-5xl italic font-light leading-relaxed text-white/95 mb-8">
          "Most founders do not lack ideas. They lack clarity on what to do next, in what order, and why it matters. I help you cut through analysis paralysis and turn strategy into a sequenced execution plan."
        </blockquote>
        <div class="font-serif text-xl text-white/70 pt-6 border-t border-white/10">
          After building and scaling products for 15+ years—from cohort-based courses to healthcare SaaS—I have seen what actually works. Not theory. Not best practices from Silicon Valley newsletters. Real patterns from real execution.
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS - White Background -->
  <section class="py-12 md:py-12 border-x border-dashed border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-8">FIGURE 04: FOUNDER FEEDBACK</div>
      <h2 class="font-serif text-5xl md:text-6xl font-bold mb-20 text-base-content leading-[0.85]">What founders say</h2>

      <div class="grid md:grid-cols-2 gap-0 border border-base-content/10">
        {testimonials.map((t, index) => (
          <div class={`border-r last:border-r-0 md:border-b-0 ${index < 2 ? 'border-b' : ''} border-base-content/10 p-10 md:p-12 bg-white min-h-[280px] flex flex-col justify-between`}>
            <blockquote class="font-serif text-xl md:text-2xl leading-relaxed text-base-content/90 italic">
              "{t.quote}"
            </blockquote>
            <div class="pt-6 mt-6 border-t border-base-content/10">
              <div class="font-serif font-bold text-base-content text-lg">{t.name}</div>
              <div class="font-mono text-xs text-base-content/50 mt-2 tracking-[0.1em]">{t.title}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA - Beige Background -->
  <section class="bg-[#f0f0eb] py-12 md:py-12 border-y border-dashed border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-4xl">
        <h2 class="font-serif text-4xl md:text-5xl font-bold mb-6 text-base-content leading-[0.85]">
          Ready to <span class="italic font-light">get</span> unstuck?
        </h2>
        <p class="font-serif text-lg md:text-xl text-base-content/70 mb-8 leading-relaxed">
          Book a call. Share what you are building, what is working, and what feels stuck. I will tell you if I can help and what the best first step is.
        </p>

        <a
          class="group inline-block px-12 py-5 bg-base-content text-base-100 font-mono text-sm uppercase tracking-[0.2em] border border-base-content shadow-[6px_6px_0px_0px_#272048] hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-[3px_3px_0px_0px_#272048] transition-all duration-300"
          href={BOOK_CALL_LINK}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
          <span class="inline-block ml-2 group-hover:scale-110 transition-transform">→</span>
        </a>

        <div class="mt-16 p-8 border border-base-content/20 bg-white">
          <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-4">WHAT TO SEND</div>
          <p class="font-serif text-lg text-base-content/80 leading-relaxed">
            If you send 5 lines with: <strong>what you sell</strong>, <strong>who you sell to</strong>, <strong>current traction</strong>, <strong>what is stuck</strong>, and <strong>what you have tried</strong>, I can be decisive fast.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
</div>
