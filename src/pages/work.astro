---
import BaseLayout from "../layouts/BaseLayout.astro";

// Themed images for active/upcoming projects (Unsplash)
const images = {
  youtube: "https://images.unsplash.com/photo-1611162616475-46b635cb6868?w=800&h=450&fit=crop",
  education: "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=800&h=450&fit=crop",
  academy: "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=800&h=450&fit=crop",
  healthcare: "https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=800&h=450&fit=crop",
};

const establishedProjects = [
  {
    title: "SellOnTube",
    img: images.youtube,
    desc: "YouTube-first customer acquisition for internet businesses in a Done-For-You model.",
    url: "https://sellontube.com",
    badge: "RUNNING",
  },
  {
    title: "The Second Design",
    img: "/second-design.png",
    desc: "An education design studio building transformational learning environments. Cohort-based programs, curriculum design, and facilitator training.",
    url: "https://theseconddesign.com",
    badge: "RUNNING",
  },
];

const exploringProjects = [
  {
    title: "Shipping with AI",
    img: "https://images.unsplash.com/photo-1677442135703-1787eea5ce01?w=800&h=450&fit=crop",
    desc: "The no BS AI show. Real workflows, real business outcomes. Guests screen-share the workflow: every click, every prompt, every tool.",
    url: "https://shippingwith.ai/",
    badge: "NEW BET",
  },
  {
    title: "SimpleScheduleAI",
    img: images.healthcare,
    desc: "A product-in-progress for US healthcare scheduling, focused on reducing operational chaos, overtime, and burnout.",
    url: "https://simplescheduleai.com",
    badge: "NEW BET",
  },
];

const pastProjects = [
  {
    title: "HowToCBC (2021-2023)",
    desc: "Helped professionals in the US and European markets build and run cohort-based courses.",
    url: "https://web.archive.org/web/20240424175652/https://howtocbc.com/",
    badge: "PAST",
  },
  {
    title: "Pupilfirst (2018-2021)",
    desc: "Evolved from Startup Village Collective into an education tech company, helping students in India upskill on product development and coding skills.",
    url: "https://www.pupilfirst.org/",
    badge: "PAST",
  },
  {
    title: "Startup Village Collective (SV.CO) (2015-2018)",
    desc: "Launched the online incubator after completing digitization. Helped students build real products and companies across India through cohort-style programs.",
    url: "https://web.archive.org/web/20180822114305/https://www.sv.co/",
    badge: "PAST",
  },
  {
    title: "SV Labs (2013-2015)",
    desc: "Built the digital platform that became the foundation for digitizing the award-winning Kochi-based incubator, Startup Village.",
    url: "https://web.archive.org/web/20150219070232/http://www.startupvillage.in/",
    badge: "PAST",
  },
];

const partOf = [
  {
    title: "AI Boomi",
    desc: "India's inner circle for AI-native founders and product builders.",
    url: "/blog/vip-access-a-volunteers-memoir/",
    badge: "VOLUNTEER",
  },
  {
    title: "Roach Mafia",
    desc: "An offline retreat for founders who chose resilience over hype.",
    url: "https://roachmafia.com/",
    badge: "FOUNDING MEMBER",
  },
  {
    title: "Write of Passage",
    desc: "David Perell's writing program. The best educational experience I have been part of.",
    url: "https://writeofpassage.com/",
    badge: "ALUMNI",
  },
];

const allSections = [
  { title: "Running", projects: establishedProjects, bg: "bg-base-200", badgeStyle: "established" },
  { title: "New Bets", projects: exploringProjects, bg: "bg-base-100", badgeStyle: "exploring" },
  { title: "Part of", projects: partOf, bg: "bg-base-100", badgeStyle: "default" },
  { title: "Past", projects: pastProjects, bg: "bg-white", badgeStyle: "default" },
];
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title="Work" sideBarActiveItemID="work">
  <!-- HERO -->
  <section class="py-6 md:py-8 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10">
    <div class="space-y-3 max-w-5xl">
      <div class="inline-flex items-center bg-teal-50 px-3 py-1.5 rounded-full">
        <span class="text-xs font-sans font-semibold text-teal-700 tracking-wide">WORK</span>
      </div>

      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight tracking-tight text-base-content">
        What I <span class="text-teal-600 font-normal">build</span> and what I'm part of.
      </h1>

      <p class="font-serif text-base md:text-lg text-base-content/70 max-w-3xl leading-relaxed">
        Running businesses, new bets, communities I'm part of, and what came before.
      </p>
    </div>
  </section>

  <!-- PROJECT SECTIONS -->
  {allSections.map((section, sectionIndex) => (
    <section class={`${section.bg} py-6 md:py-8 border-y border-solid border-base-content/10`}>
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-2">{section.title.toUpperCase()}</div>
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-4 text-base-content leading-tight">{section.title}</h2>

        {section.title === "Past" ? (
          <div class="border-t border-base-content/10">
            {section.projects.map((p) => (
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block border-b border-base-content/10 py-4 hover:bg-base-content hover:-mx-12 hover:px-12 transition-all duration-500"
              >
                <div class="flex items-center justify-between gap-4">
                  <div class="flex-grow">
                    <div class="flex items-center gap-2 mb-1">
                      <h3 class="font-serif text-lg md:text-xl font-bold text-base-content group-hover:text-white transition-colors">{p.title}</h3>
                      <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] px-2 py-1 bg-base-content text-white border border-base-content group-hover:bg-white group-hover:text-base-content group-hover:border-white transition-all">{p.badge}</span>
                    </div>
                    <p class="font-serif text-sm md:text-base text-base-content/80 group-hover:text-white/90 transition-colors">{p.desc}</p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/50 group-hover:text-white group-hover:opacity-100 group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="grid md:grid-cols-2 gap-3">
            {section.projects.map((p) => (
              <a
                href={p.url}
                target={p.url.startsWith("http") ? "_blank" : "_self"}
                rel={p.url.startsWith("http") ? "noopener noreferrer" : undefined}
                class="group flex items-start justify-between gap-4 bg-white border border-base-content/10 rounded-xl p-5 hover:border-base-content/30 hover:shadow-sm transition-all duration-200"
              >
                <div>
                  <div class="flex items-center gap-2 mb-1.5">
                    <h3 class="font-serif text-lg font-bold text-base-content">{p.title}</h3>
                    <span class={`text-xs font-sans font-semibold px-2 py-0.5 rounded-full ${section.badgeStyle === 'established' ? 'bg-teal-50 text-teal-700' : section.badgeStyle === 'exploring' ? 'bg-amber-50 text-amber-700' : 'bg-base-200 text-base-content/60'}`}>{p.badge}</span>
                  </div>
                  <p class="font-serif text-sm text-base-content/60 leading-relaxed">{p.desc}</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content/30 group-hover:text-base-content group-hover:translate-x-0.5 transition-all flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}
</BaseLayout>
</div>
