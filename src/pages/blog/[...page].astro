---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";
import dayjs from "dayjs";

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection("blog", ({ data }) => !data.hidden);
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 50 });
}

const { page } = Astro.props;
const latest = page.data[0];
const rest = page.data.slice(1);
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title="Blog" sideBarActiveItemID="blog">
  <section class="py-10 md:py-14 max-w-2xl mx-auto px-6 md:px-0">

    {latest && (
      <div class="mb-10">
        <p class="font-sans text-xs font-semibold text-base-content/40 uppercase tracking-widest mb-4">Latest</p>
        <a href={"/blog/" + createSlug(latest.data.title, latest.slug)} class="group block">
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-base-content group-hover:text-teal-600 transition-colors mb-1">{latest.data.title}</h2>
          <p class="font-sans text-sm text-base-content/40 mb-3">{dayjs(latest.data.pubDate).format("MMMM D, YYYY")}</p>
          <p class="font-serif text-base text-base-content/70 leading-relaxed">
            {latest.data.description} <span class="text-teal-600 group-hover:underline">Keep reading →</span>
          </p>
        </a>
      </div>
    )}

    <div class="border-t border-base-content/10 pt-8">
      <p class="font-sans text-xs font-semibold text-base-content/40 uppercase tracking-widest mb-5">All posts</p>
      <div class="space-y-3">
        {rest.map((post) => (
          <a
            href={"/blog/" + createSlug(post.data.title, post.slug)}
            class="group flex items-baseline gap-5"
          >
            <span class="font-sans text-sm text-base-content/35 tabular-nums flex-shrink-0">
              {dayjs(post.data.pubDate).format("YYYY · MM")}
            </span>
            <span class="font-serif text-base text-base-content group-hover:text-teal-600 transition-colors">{post.data.title}</span>
          </a>
        ))}
      </div>
    </div>

    {(page.url.prev || page.url.next) && (
      <div class="flex justify-between mt-10 pt-6 border-t border-base-content/10">
        {page.url.prev ? <a href={page.url.prev} class="font-sans text-sm text-base-content/50 hover:text-base-content transition-colors">← Newer</a> : <div />}
        {page.url.next ? <a href={page.url.next} class="font-sans text-sm text-base-content/50 hover:text-base-content transition-colors">Older →</a> : <div />}
      </div>
    )}

  </section>
</BaseLayout>
</div>
