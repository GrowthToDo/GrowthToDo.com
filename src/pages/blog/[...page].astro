---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug"

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection("blog");
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title="Blog" sideBarActiveItemID="blog">
  <!-- HERO -->
  <section class="py-6 md:py-8 max-w-7xl mx-auto px-6 md:px-12 border-x border-dashed border-base-content/10">
    <div class="space-y-3 max-w-5xl">
      <div class="inline-block border border-base-content/10 px-3 py-1.5">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/70">BLOG</span>
      </div>

      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-[0.85] tracking-tight text-base-content">
        Writing<span class="italic font-light">.</span>
      </h1>

      <p class="font-serif text-base md:text-lg text-base-content/70 max-w-3xl leading-relaxed">
        Thoughts on product, strategy, distribution, and building internet-first businesses.
      </p>
    </div>
  </section>

  <!-- POSTS -->
  <section class="bg-[#f9f9f7] py-6 md:py-8 border-y border-dashed border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-4">FIGURE 01: ALL POSTS</div>

      {page.data.length === 0 ? (
        <div class="bg-white border border-base-content/10 p-8">
          <p class="font-serif text-xl font-bold mb-2">No posts yet</p>
          <p class="font-serif text-base-content/60">Check back later for new content.</p>
        </div>
      ) : (
        <div class="border-t border-base-content/10">
          {page.data.map((post) => (
            <a
              href={"/blog/" + createSlug(post.data.title, post.slug)}
              class="group block border-b border-base-content/10 py-5 md:py-6 hover:bg-base-content hover:-mx-12 hover:px-12 transition-all duration-500"
            >
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="font-serif text-xl md:text-2xl font-bold text-base-content group-hover:text-white transition-colors">{post.data.title}</h2>
                  {post.data.badge && (
                    <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] px-3 py-1.5 bg-base-content text-white border border-base-content group-hover:bg-white group-hover:text-base-content group-hover:border-white transition-all">{post.data.badge}</span>
                  )}
                </div>
                <p class="font-serif text-sm md:text-base text-base-content/80 group-hover:text-white/90 leading-relaxed max-w-3xl transition-colors">{post.data.description}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 pt-1">
                    {post.data.tags.map((tag) => (
                      <span class="font-mono text-xs uppercase tracking-[0.1em] px-2 py-1 border border-base-content/30 text-base-content/60 group-hover:border-white/50 group-hover:text-white/80 transition-colors">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      )}

      <!-- PAGINATION -->
      {(page.url.prev || page.url.next) && (
        <div class="flex justify-between mt-6 pt-6 border-t border-base-content/10">
          {page.url.prev ? (
            <a
              href={page.url.prev}
              class="inline-block px-6 py-3 bg-base-content text-base-100 font-mono text-xs uppercase tracking-[0.2em] border border-base-content shadow-[3px_3px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[1px_1px_0px_0px_#272048] transition-all duration-300"
            >
              ← Newer posts
            </a>
          ) : <div />}
          {page.url.next ? (
            <a
              href={page.url.next}
              class="inline-block px-6 py-3 bg-base-content text-base-100 font-mono text-xs uppercase tracking-[0.2em] border border-base-content shadow-[3px_3px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[1px_1px_0px_0px_#272048] transition-all duration-300"
            >
              Older posts →
            </a>
          ) : <div />}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
</div>
