---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Founder OS";
const description =
  "The plain-text operating system I run my work from. An AI agent, a set of markdown files, and a few rules that keep several businesses from falling through the cracks.";

const F = "'Plus Jakarta Sans', ui-sans-serif, sans-serif";
const S = "'Spectral', ui-serif, serif";

const stats = [
  { value: "6", label: "life areas, one structure" },
  { value: "1", label: "AI agent, by voice" },
  { value: "100%", label: "plain text, no app" },
  { value: "Daily", label: "since May 2026" },
];

const fixed = [
  {
    title: "People stopped slipping",
    body: "Every reply I owe carries a nudge date. Miss it and it surfaces at the top of tomorrow.",
  },
  {
    title: "Contacts became queryable",
    body: "Typed links between people. Ask who can introduce me to a company and the answer comes from the graph.",
  },
  {
    title: "Nothing gets re-explained",
    body: "Repeating jobs are written as routines. The agent runs them; I review the output.",
  },
];
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title={title} description={description} sideBarActiveItemID="founder-os">

  <div class="py-6 md:py-14 max-w-3xl mx-auto px-1 md:px-0">

    <!-- Hero -->
    <header class="space-y-5 mb-12">
      <p class="font-sans text-xs font-semibold uppercase tracking-widest text-teal-600">Founder OS</p>
      <h1 class="font-serif text-3xl md:text-5xl font-normal leading-[1.1] tracking-tight text-base-content">
        The operating system<br class="hidden md:block" /> I run my work from.
      </h1>
      <p class="font-serif text-xl md:text-2xl leading-snug text-base-content/60 max-w-2xl">
        Plain text files. An AI agent that works them by voice. A few rules that keep several
        businesses from falling through the cracks.
      </p>
    </header>

    <!-- Stat band -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-base-content/10 border border-base-content/10 rounded-2xl overflow-hidden mb-16">
      {stats.map((s) => (
        <div class="bg-base-100 p-5 md:p-6">
          <div class="font-serif text-3xl md:text-4xl text-teal-600 leading-none mb-1.5">{s.value}</div>
          <div class="font-sans text-xs md:text-sm text-base-content/50 leading-tight">{s.label}</div>
        </div>
      ))}
    </div>

    <!-- The bet -->
    <section class="mb-16">
      <p class="font-serif text-2xl md:text-3xl leading-snug text-base-content text-center max-w-2xl mx-auto">
        Most systems become a place to <span class="text-base-content/40">store things.</span><br />
        This one is a place to <span class="text-teal-600">act from.</span>
      </p>
    </section>

    <!-- ===================== HOW IT WORKS ===================== -->
    <section class="mb-16">
      <div class="mb-8">
        <h2 class="font-serif text-2xl md:text-3xl text-base-content mb-2">How it works</h2>
        <p class="font-serif text-lg text-base-content/60 max-w-2xl">
          Two views of the same machine: the shape it has, and how work moves through it.
        </p>
      </div>

      <!-- Four swappable layers -->
      <div class="mb-12">
        <h3 class="font-sans text-sm font-semibold uppercase tracking-wider text-base-content/40 mb-2">Four layers, not a locked stack</h3>
        <p class="font-serif text-lg leading-relaxed text-base-content/75 mb-5 max-w-2xl">
          This isn't a product stack, it's an architecture. Each layer does one job, and the tool
          named below it is just my current pick for that job. Swap any one out without breaking
          the shape.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="border border-base-content/10 rounded-2xl p-5 bg-base-100">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-8 h-8 rounded-lg bg-teal-50 border border-teal-200 flex items-center justify-center">
                <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5M3 17l9 5 9-5" /></svg>
              </div>
              <p class="font-serif text-lg text-base-content">Memory</p>
            </div>
            <p class="font-sans text-xs font-semibold uppercase tracking-wide text-base-content/35 mb-1.5">currently: Obsidian</p>
            <p class="font-sans text-sm text-base-content/55 leading-snug">The surface we both read and write. Long-term context that barely changes, plus working memory that gets processed daily and cleared into the log.</p>
          </div>
          <div class="border border-base-content/10 rounded-2xl p-5 bg-base-100">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-8 h-8 rounded-lg bg-teal-50 border border-teal-200 flex items-center justify-center">
                <svg class="w-4 h-4 text-teal-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.5l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9z" /></svg>
              </div>
              <p class="font-serif text-lg text-base-content">The model</p>
            </div>
            <p class="font-sans text-xs font-semibold uppercase tracking-wide text-base-content/35 mb-1.5">currently: Claude Code</p>
            <p class="font-sans text-sm text-base-content/55 leading-snug">The reasoning and writing engine. Whichever LLM earns the trust right now — the architecture doesn't care which.</p>
          </div>
          <div class="border border-base-content/10 rounded-2xl p-5 bg-base-100">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-8 h-8 rounded-lg bg-teal-50 border border-teal-200 flex items-center justify-center">
                <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75a1.5 1.5 0 0 1 1.5-1.5h13.5a1.5 1.5 0 0 1 1.5 1.5v10.5a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V6.75zM7 10l2.5 2.5L7 15M12.5 15h4" /></svg>
              </div>
              <p class="font-serif text-lg text-base-content">The interface</p>
            </div>
            <p class="font-sans text-xs font-semibold uppercase tracking-wide text-base-content/35 mb-1.5">currently: the terminal</p>
            <p class="font-sans text-sm text-base-content/55 leading-snug">Where I actually talk to the model. No app, no dashboard, no tab to keep open.</p>
          </div>
          <div class="border border-base-content/10 rounded-2xl p-5 bg-base-100">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-8 h-8 rounded-lg bg-teal-50 border border-teal-200 flex items-center justify-center">
                <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zM6 11a6 6 0 0 0 12 0M12 18v3" /></svg>
              </div>
              <p class="font-serif text-lg text-base-content">Dictation</p>
            </div>
            <p class="font-sans text-xs font-semibold uppercase tracking-wide text-base-content/35 mb-1.5">currently: Voicenotes</p>
            <p class="font-sans text-sm text-base-content/55 leading-snug">Turns speech into text the model can act on. The layer that makes "by voice" actually true.</p>
          </div>
        </div>
      </div>

      <!-- shared SVG defs: icons, gradients, shadow, arrowheads -->
      <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
          <filter id="sh" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="#0f3d38" flood-opacity="0.10"/></filter>
          <filter id="shSoft" x="-50%" y="-50%" width="200%" height="200%"><feDropShadow dx="0" dy="4" stdDeviation="9" flood-color="#0d9488" flood-opacity="0.18"/></filter>
          <linearGradient id="gTeal" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2dd4bf"/><stop offset="1" stop-color="#0d9488"/></linearGradient>
          <linearGradient id="gDark" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#44403c"/><stop offset="1" stop-color="#292524"/></linearGradient>
          <linearGradient id="gAccent" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f0fdfa"/><stop offset="1" stop-color="#d9f7f1"/></linearGradient>
          <radialGradient id="glow" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#5eead4" stop-opacity="0.18"/><stop offset="1" stop-color="#5eead4" stop-opacity="0"/></radialGradient>
          <marker id="aT" markerWidth="11" markerHeight="11" refX="7.5" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 L2.4,4 Z" fill="#0d9488"/></marker>
          <marker id="aM" markerWidth="11" markerHeight="11" refX="7.5" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 L2.4,4 Z" fill="#a8a29e"/></marker>
          <symbol id="icDoc" viewBox="0 0 24 24"><path d="M14 3v4a1 1 0 0 0 1 1h4M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-5-5z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
          <symbol id="icMic" viewBox="0 0 24 24"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zM6 11a6 6 0 0 0 12 0M12 18v3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
          <symbol id="icSpark" viewBox="0 0 24 24"><path d="M12 2.5l2 6.5 6.5 2-6.5 2-2 6.5-2-6.5-6.5-2 6.5-2z" fill="currentColor"/></symbol>
          <symbol id="icCheck" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
          <symbol id="icBell" viewBox="0 0 24 24"><path d="M6 9a6 6 0 0 1 12 0c0 7 3 5 3 9H3c0-4 3-2 3-9M10.5 21a1.5 1.5 0 0 0 3 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
          <symbol id="icLayers" viewBox="0 0 24 24"><path d="M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5M3 17l9 5 9-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        </defs>
      </svg>

      <!-- ---- The architecture (hub) ---- -->
      <div class="mb-12">
        <h3 class="font-sans text-sm font-semibold uppercase tracking-wider text-base-content/40 mb-2">The architecture</h3>
        <p class="font-serif text-lg leading-relaxed text-base-content/75 mb-5 max-w-2xl">
          The shape is simple. One AI agent (Claude Code), driven by your voice, sits between two
          layers of plain text in an Obsidian vault. One layer holds what is true and barely changes.
          The other holds what is happening now. The agent reads from both and writes back to both.
        </p>

        <div class="rounded-2xl border border-base-content/10 bg-base-100 p-2 md:p-4 overflow-x-auto">
          <svg viewBox="0 0 900 600" class="w-full min-w-[640px]" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="900" height="600" rx="16" fill="#fbfdfd"/>
            <ellipse cx="450" cy="300" rx="280" ry="220" fill="url(#glow)"/>

            <rect x="248" y="36" width="404" height="110" rx="16" fill="#f7f7f6" stroke="#ececea" stroke-width="1.5" filter="url(#sh)"/>
            <text x="270" y="62" font-family={F} font-size="11" font-weight="700" letter-spacing="1.2" fill="#78716c">LONG-TERM MEMORY &#183; WHAT IS TRUE</text>
            <rect x="268" y="72" width="116" height="56" rx="10" fill="#fff" stroke="#ececea"/><use href="#icDoc" x="278" y="84" width="13" height="13" style="color:#0d9488"/><text x="326" y="100" text-anchor="middle" font-family={F} font-size="11" font-weight="600" fill="#292524">Projects</text><text x="326" y="116" text-anchor="middle" font-family={F} font-size="8.5" fill="#a8a29e">4 sections each</text>
            <rect x="392" y="72" width="116" height="56" rx="10" fill="#fff" stroke="#ececea"/><use href="#icLayers" x="402" y="84" width="13" height="13" style="color:#0d9488"/><text x="450" y="100" text-anchor="middle" font-family={F} font-size="11" font-weight="600" fill="#292524">People</text><text x="450" y="116" text-anchor="middle" font-family={F} font-size="8.5" fill="#a8a29e">+ relationship graph</text>
            <rect x="516" y="72" width="116" height="56" rx="10" fill="#fff" stroke="#ececea"/><use href="#icDoc" x="526" y="84" width="13" height="13" style="color:#0d9488"/><text x="574" y="100" text-anchor="middle" font-family={F} font-size="11" font-weight="600" fill="#292524">Index</text><text x="574" y="116" text-anchor="middle" font-family={F} font-size="8.5" fill="#a8a29e">quick scan</text>

            <line x1="450" y1="146" x2="450" y2="236" stroke="#0d9488" stroke-width="1.8" marker-start="url(#aT)" marker-end="url(#aT)"/>
            <rect x="462" y="178" width="170" height="22" rx="11" fill="#fff" stroke="#e7e5e4"/><text x="547" y="193" text-anchor="middle" font-family={F} font-size="10" fill="#0f766e">reads truth, writes facts</text>

            <rect x="64" y="266" width="150" height="66" rx="14" fill="#fff" stroke="#eceae8" stroke-width="1.5" filter="url(#sh)"/>
            <use href="#icMic" x="92" y="286" width="17" height="17" style="color:#0d9488"/>
            <text x="146" y="296" text-anchor="middle" font-family={S} font-size="15" fill="#292524">You</text>
            <text x="146" y="314" text-anchor="middle" font-family={F} font-size="10.5" fill="#78716c">by voice</text>
            <path d="M214,299 C 290,299 330,300 384,300" fill="none" stroke="#0d9488" stroke-width="1.8" marker-end="url(#aT)"/>
            <text x="300" y="290" text-anchor="middle" font-family={F} font-size="10" fill="#78716c">you ask</text>

            <circle cx="450" cy="300" r="72" fill="none" stroke="#5eead4" stroke-width="7" opacity="0.35"/>
            <circle cx="450" cy="300" r="58" fill="url(#gTeal)" filter="url(#shSoft)"/>
            <use href="#icSpark" x="438" y="262" width="24" height="24" style="color:#fff"/>
            <text x="450" y="306" text-anchor="middle" font-family={S} font-size="16" fill="#fff">The AI agent</text>
            <text x="450" y="324" text-anchor="middle" font-family={F} font-size="9.5" fill="#d4f6f0">reads &#183; reasons &#183; writes</text>

            <path d="M508,300 C 590,300 630,300 676,300" fill="none" stroke="#0d9488" stroke-width="1.8" marker-end="url(#aT)"/>
            <text x="596" y="290" text-anchor="middle" font-family={F} font-size="10" fill="#78716c">you get</text>
            <rect x="678" y="252" width="166" height="96" rx="14" fill="#fff" stroke="#eceae8" stroke-width="1.5" filter="url(#sh)"/>
            <text x="696" y="274" font-family={F} font-size="11" font-weight="700" fill="#292524">You get</text>
            <use href="#icCheck" x="694" y="284" width="12" height="12" style="color:#0d9488"/><text x="712" y="294" font-family={S} font-size="11.5" fill="#57534e">A prioritized agenda</text>
            <use href="#icCheck" x="694" y="302" width="12" height="12" style="color:#0d9488"/><text x="712" y="312" font-family={S} font-size="11.5" fill="#57534e">Drafts to send</text>
            <use href="#icCheck" x="694" y="320" width="12" height="12" style="color:#0d9488"/><text x="712" y="330" font-family={S} font-size="11.5" fill="#57534e">Nudges before slips</text>

            <line x1="450" y1="358" x2="450" y2="428" stroke="#0d9488" stroke-width="1.8" marker-start="url(#aT)" marker-end="url(#aT)"/>
            <rect x="462" y="382" width="150" height="22" rx="11" fill="#fff" stroke="#e7e5e4"/><text x="537" y="397" text-anchor="middle" font-family={F} font-size="10" fill="#0f766e">drives &amp; records</text>

            <rect x="168" y="430" width="564" height="138" rx="16" fill="#f7f7f6" stroke="#ececea" stroke-width="1.5" filter="url(#sh)"/>
            <text x="190" y="456" font-family={F} font-size="11" font-weight="700" letter-spacing="1.2" fill="#78716c">WORKING MEMORY &#183; WHAT IS HAPPENING NOW</text>
            <rect x="188" y="468" width="122" height="46" rx="10" fill="#fff" stroke="#ececea"/><use href="#icDoc" x="198" y="480" width="12" height="12" style="color:#0d9488"/><text x="249" y="489" text-anchor="middle" font-family={F} font-size="10.5" font-weight="600" fill="#292524">ToDos</text><text x="249" y="503" text-anchor="middle" font-family={F} font-size="8.5" fill="#a8a29e">your work</text>
            <rect x="318" y="468" width="122" height="46" rx="10" fill="#fff" stroke="#ececea"/><use href="#icDoc" x="328" y="480" width="12" height="12" style="color:#0d9488"/><text x="379" y="489" text-anchor="middle" font-family={F} font-size="10.5" font-weight="600" fill="#292524">Conversations</text><text x="379" y="503" text-anchor="middle" font-family={F} font-size="8.5" fill="#a8a29e">people + nudges</text>
            <rect x="448" y="468" width="122" height="46" rx="10" fill="#fff" stroke="#ececea"/><use href="#icDoc" x="458" y="480" width="12" height="12" style="color:#0d9488"/><text x="509" y="489" text-anchor="middle" font-family={F} font-size="10.5" font-weight="600" fill="#292524">Working Doc</text><text x="509" y="503" text-anchor="middle" font-family={F} font-size="8.5" fill="#a8a29e">drafts</text>
            <rect x="578" y="468" width="136" height="46" rx="10" fill="url(#gAccent)" stroke="#5eead4"/><use href="#icCheck" x="588" y="480" width="12" height="12" style="color:#0f766e"/><text x="648" y="489" text-anchor="middle" font-family={F} font-size="10.5" font-weight="600" fill="#0f766e">Done Tracker</text><text x="648" y="503" text-anchor="middle" font-family={F} font-size="8.5" fill="#5eada3">dated log</text>
            <text x="190" y="544" font-family={F} font-size="9.5" fill="#a8a29e">finished items flow into the Done Tracker &#8594; distilled each morning into the Daily Summary</text>
          </svg>
        </div>
        <p class="font-sans text-sm text-base-content/45 mt-3">Plain files, not an app. The clean layer stays readable; the messy layer absorbs the day.</p>
      </div>

      <!-- ---- The lifecycle (flowchart) ---- -->
      <div>
        <h3 class="font-sans text-sm font-semibold uppercase tracking-wider text-base-content/40 mb-2">The lifecycle</h3>
        <p class="font-serif text-lg leading-relaxed text-base-content/75 mb-5 max-w-2xl">
          And here is how a single item travels through it. A task is born in your to-dos, anything
          through a person in your conversations, both get worked in the scratch pad, then wrap into
          the dated done log, which becomes tomorrow's summary. Every session opens and closes on its
          own.
        </p>

        <div class="rounded-2xl border border-base-content/10 bg-base-100 p-2 md:p-4 overflow-x-auto">
          <svg viewBox="0 0 900 840" class="w-full min-w-[640px]" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="900" height="840" rx="16" fill="#fbfdfd"/>
            <ellipse cx="450" cy="110" rx="460" ry="170" fill="url(#glow)"/>

            <rect x="70" y="26" width="760" height="46" rx="13" fill="url(#gTeal)" filter="url(#sh)"/>
            <use href="#icSpark" x="94" y="40" width="18" height="18" style="color:#fff"/>
            <text x="464" y="55" text-anchor="middle" font-family={F} font-size="13" font-weight="600" fill="#fff">SESSION START &#183; reads every file, surfaces overdue, builds the agenda</text>

            <line x1="450" y1="72" x2="450" y2="96" stroke="#0d9488" stroke-width="1.8" marker-end="url(#aT)"/>
            <rect x="356" y="98" width="188" height="58" rx="16" fill="#fff" stroke="#eceae8" stroke-width="1.5" filter="url(#sh)"/>
            <use href="#icMic" x="384" y="116" width="18" height="18" style="color:#0d9488"/>
            <text x="470" y="124" text-anchor="middle" font-family={S} font-size="15.5" fill="#292524">You speak</text>
            <text x="470" y="142" text-anchor="middle" font-family={F} font-size="11" fill="#78716c">by voice</text>

            <text x="84" y="210" font-family={F} font-size="11" font-weight="700" letter-spacing="1.5" fill="#a8a29e">WORK</text>
            <text x="596" y="210" font-family={F} font-size="11" font-weight="700" letter-spacing="1.5" fill="#5eada3">PEOPLE</text>

            <rect x="68" y="218" width="258" height="186" rx="18" fill="#faf9f8" stroke="#f0eeec" stroke-width="1.5"/>
            <rect x="574" y="218" width="258" height="206" rx="18" fill="#f3fdfb" stroke="#dcf5f0" stroke-width="1.5"/>

            <path d="M450,156 C 320,184 197,182 197,228" fill="none" stroke="#0d9488" stroke-width="1.8" marker-end="url(#aT)"/>
            <path d="M450,156 C 590,184 703,182 703,228" fill="none" stroke="#0d9488" stroke-width="1.8" marker-end="url(#aT)"/>

            <rect x="84" y="230" width="226" height="156" rx="14" fill="#fff" stroke="#eceae8" stroke-width="1.5" filter="url(#sh)"/>
            <use href="#icDoc" x="102" y="248" width="15" height="15" style="color:#0d9488"/>
            <text x="124" y="261" font-family={F} font-size="12.5" font-weight="700" fill="#292524">ToDos.md</text>
            <text x="292" y="261" text-anchor="end" font-family={F} font-size="9.5" fill="#a8a29e">your own work</text>
            <line x1="102" y1="272" x2="292" y2="272" stroke="#f0eeec" stroke-width="1.5"/>
            <circle cx="106" cy="294" r="3" fill="#14b8a6"/><text x="118" y="298" font-family={S} font-size="13" fill="#57534e">Priority</text>
            <circle cx="106" cy="318" r="3" fill="#14b8a6"/><text x="118" y="322" font-family={S} font-size="13" fill="#57534e">Up Next</text>
            <circle cx="106" cy="342" r="3" fill="#14b8a6"/><text x="118" y="346" font-family={S} font-size="13" fill="#57534e">Backlog</text>
            <text x="102" y="370" font-family={F} font-size="9.5" fill="#a8a29e">no people ever live here</text>

