---
import BaseLayout from "../layouts/BaseLayout.astro";

const BOOK_CALL_LINK = "https://growthtodo.neetocal.com/30mins";
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout sideBarActiveItemID="now">

  <section class="py-6 md:py-20 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10 md:min-h-screen md:flex md:flex-col md:justify-center">
    <div class="space-y-5 md:space-y-8 max-w-2xl">

      <h1 class="font-serif text-2xl md:text-3xl font-normal leading-snug tracking-tight text-base-content/80">
        Hi, I'm Gautham and here's what I'm <span class="text-teal-600 font-normal">upto now.</span>
      </h1>

      <div class="space-y-3">
        <ul class="space-y-2 list-disc list-inside marker:text-teal-500 marker:text-lg">
          <li class="font-serif text-xl text-base-content">Helping businesses <a href="https://sellontube.com" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">win customers on YouTube</a></li>
          <li class="font-serif text-xl text-base-content">Preparing students for <a href="https://theseconddesign.com/real-world-ready" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">elite careers and entrepreneurship</a></li>
          <li class="font-serif text-xl text-base-content">Showcasing <a href="https://shippingwith.ai/" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">transformational AI workflows</a> <span class="inline-block font-sans text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200 align-middle relative -top-0.5">New</span></li>
          <li class="font-serif text-xl text-base-content">Building <a href="https://simplescheduleai.com" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">smarter scheduling systems for US hospitals</a> <span class="inline-block font-sans text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200 align-middle relative -top-0.5">New</span></li>
        </ul>
        <a href="/work" class="inline-block font-sans text-sm text-base-content/50 hover:text-base-content transition-colors pt-1">See all →</a>
      </div>


    </div>
  </section>

</BaseLayout>
</div>
