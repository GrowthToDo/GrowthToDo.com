---
import BaseLayout from "../layouts/BaseLayout.astro";
import UpdatesSignup from "../components/UpdatesSignup.astro";

const BOOK_CALL_LINK = "https://growthtodo.neetocal.com/30mins";
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout sideBarActiveItemID="now">

  <section class="py-4 md:py-20 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10 md:min-h-screen md:flex md:flex-col md:justify-center">
    <div class="space-y-3 md:space-y-8 max-w-2xl">

      <h1 class="font-serif text-xl md:text-3xl font-normal leading-snug tracking-tight text-base-content/80">
        Hi, I'm Gautham and here's what I'm <span class="text-teal-600 font-normal">upto now.</span>
      </h1>

      <div class="space-y-2.5 md:space-y-5">

        <div class="rounded-2xl border border-base-content/10 px-4 py-2.5 md:px-5 md:py-4 space-y-1 md:space-y-2 transition-transform duration-200 hover:-translate-y-0.5">
          <p class="font-sans text-xs font-semibold uppercase tracking-widest text-base-content/40">💼 The work</p>
          <ul class="space-y-0.5 md:space-y-2 list-disc list-inside marker:text-teal-500 marker:text-base md:marker:text-lg">
            <li class="font-serif text-base md:text-xl leading-snug text-base-content">Helping <a href="https://sellontube.com/shopify-app" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">Shopify apps grow</a> and businesses win customers on <a href="https://sellontube.com" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">YouTube</a></li>
            <li class="font-serif text-base md:text-xl leading-snug text-base-content">Building <a href="https://simplescheduleai.com" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">smarter scheduling systems for US hospitals</a></li>
          </ul>
        </div>

        <div class="rounded-2xl border border-base-content/10 px-4 py-2.5 md:px-5 md:py-4 space-y-1 md:space-y-2 transition-transform duration-200 hover:-translate-y-0.5">
          <p class="font-sans text-xs font-semibold uppercase tracking-widest text-base-content/40">🌱 The passion project</p>
          <ul class="space-y-0.5 md:space-y-2 list-disc list-inside marker:text-teal-500 marker:text-base md:marker:text-lg">
            <li class="font-serif text-base md:text-xl leading-snug text-base-content">Preparing students for <a href="https://theseconddesign.com/real-world-ready" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">elite careers and entrepreneurship</a></li>
          </ul>
        </div>

        <div class="rounded-2xl border border-base-content/10 px-4 py-2.5 md:px-5 md:py-4 space-y-1 md:space-y-2 transition-transform duration-200 hover:-translate-y-0.5">
          <p class="font-sans text-xs font-semibold uppercase tracking-widest text-base-content/40">🔬 The tinkering</p>
          <ul class="space-y-0.5 md:space-y-2 list-disc list-inside marker:text-teal-500 marker:text-base md:marker:text-lg">
            <li class="font-serif text-base md:text-xl leading-snug text-base-content">Learning AI by building with it, and talking about it on <a href="https://shippingwith.ai/" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:underline">Shipping with AI</a></li>
          </ul>
        </div>

        <a href="/work" class="inline-block font-sans text-sm text-base-content/50 hover:text-base-content transition-colors pt-1">See all →</a>

        <UpdatesSignup source="now" />
      </div>


    </div>
  </section>

</BaseLayout>
</div>
