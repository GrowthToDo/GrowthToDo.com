---
import BaseLayout from "../../layouts/BaseLayout.astro";

const prompts = [
  "What's one clever way you use AI that you can't live without, that you don't see others doing and wish more people would?",
  "What's one technique that's saved you the most tokens?",
  "What's your best trick for cutting the back-and-forth and getting straight to the output you want with AI?",
  "What's the one thing you wish Claude Code could do for you that would make the biggest difference to your daily workflow? Stretch your imagination.",
];
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title="AI Unconference · GrowthToDo" description="A peer-driven AI unconference run at the Roach Mafia retreat, Bengaluru. Real talk on AI adoption.">

  <section class="py-6 md:py-16 max-w-3xl mx-auto px-6 md:px-12">
    <div class="space-y-10">

      <div class="space-y-4">
        <p class="font-sans text-xs font-semibold uppercase tracking-widest text-teal-600">Roach Mafia · Bengaluru · June 2026</p>
        <h1 class="font-serif text-4xl md:text-5xl font-normal leading-tight tracking-tight text-base-content">
          AI Unconference
        </h1>
        <p class="font-serif text-xl md:text-2xl text-base-content/70 leading-snug">
          Real talk on AI adoption. No speakers, no slides talking at you. The room is the agenda.
        </p>
        <div class="pt-2 flex flex-wrap gap-3">
          <a href="/ai-unconference/slides" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full bg-teal-600 text-white hover:bg-teal-700 transition-colors">
            Open the session slides →
          </a>
          <a href="/ai-unconference/roachmafia-bangalore-ai-unconference-summary" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full border border-teal-600 text-teal-700 hover:bg-teal-50 transition-colors">
            Read the summary →
          </a>
          <a href="https://docs.google.com/document/d/1vM1l7pyJKjZEvKEc15eEYr6GO743kyjRNaDk6K6WT64/edit" target="_blank" rel="noopener noreferrer" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full border border-teal-600 text-teal-700 hover:bg-teal-50 transition-colors">
            Browse the team docs →
          </a>
        </div>
      </div>

      <div class="space-y-3">
        <h2 class="font-sans text-sm font-semibold uppercase tracking-wide text-base-content/50">How it runs</h2>
        <ul class="space-y-2 list-disc list-inside marker:text-teal-500">
          <li class="font-serif text-lg text-base-content">Nine tables, about five people each.</li>
          <li class="font-serif text-lg text-base-content">Four prompts, ten minutes each.</li>
          <li class="font-serif text-lg text-base-content">Everyone answers in turn and writes into their team doc.</li>
          <li class="font-serif text-lg text-base-content">One Insight Collector per table curates a summary to share with the room, time-boxed, after each round.</li>
          <li class="font-serif text-lg text-base-content">Every team's doc is open and shared, point your AI at the lot.</li>
        </ul>
      </div>

      <div class="space-y-3">
        <h2 class="font-sans text-sm font-semibold uppercase tracking-wide text-base-content/50">The prompts</h2>
        <ol class="space-y-2 list-decimal list-inside marker:text-teal-500 marker:font-semibold">
          {prompts.map((p) => (
            <li class="font-serif text-lg text-base-content">{p}</li>
          ))}
        </ol>
      </div>

    </div>
  </section>

</BaseLayout>
</div>
