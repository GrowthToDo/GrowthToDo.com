---
import BaseLayout from "../layouts/BaseLayout.astro";

const changelog = [
  {
    date: '2026-06-04',
    version: '1.3.0',
    title: 'New blog post: VIP Access',
    changes: [
      {
        category: 'Content',
        items: [
          'Published "VIP Access: A Volunteer\'s Memoir" blog post about volunteering for AIBoomi Annual \'26',
          'Added two compressed event photos (resized from 4000px to 1600px, ~75% file size reduction)',
        ],
      },
    ],
  },
  {
    date: '2026-05-27',
    version: '1.2.1',
    title: 'Performance and build fixes',
    changes: [
      {
        category: 'Performance',
        items: [
          'Compressed profile photo from 2.4MB to 81KB (97% reduction) by resizing to 200x200',
          'Added lazy loading and explicit dimensions to profile image',
          'Added social_img.jpg (JPEG) for WhatsApp/OG link previews — WebP is not supported by WhatsApp',
        ],
      },
      {
        category: 'Build',
        items: [
          'Pinned @astrojs/sitemap to 3.2.0 (exact) to prevent pnpm resolving 3.7.3 which crashes the build',
          'Updated pnpm-lock.yaml to match package.json and unblock Netlify CI',
        ],
      },
    ],
  },
  {
    date: '2026-05-27',
    version: '1.2.0',
    title: 'Site restructure and content updates',
    changes: [
      {
        category: 'Pages',
        items: [
          'Homepage (/) now shows writing list — flat chronological list of all blog posts',
          'New /now page: professional snapshot of what I\'m working on',
          'Nav updated: Writing links to /, Now links to /now, Home removed',
        ],
      },
      {
        category: 'Content',
        items: [
          'CV: Fixed NOW badge visibility (was invisible on some timeline items)',
          'CV: Maven Accelerator description rewritten to be more understated',
          'CV: Removed "Validated the CBC platform idea by becoming the power user first" from HowToCBC',
          'CV: Changed "ads vs. organic" to "paid vs. organic" in StartGlobal highlights',
          'Work: Added Write of Passage to the Part of section',
        ],
      },
    ],
  },
  {
    date: '2026-05-20',
    version: '1.1.2',
    title: 'Blog post fixes',
    changes: [
      {
        category: 'Content',
        items: [
          'Fixed invisible text on Context/ and Daily/ labels in "My New Operating System for Work" (bold+code rendering issue)',
          'Removed all em dashes from the blog post',
        ],
      },
    ],
  },
  {
    date: '2026-05-19',
    version: '1.1.1',
    title: 'Blog post updates',
    changes: [
      {
        category: 'Content',
        items: [
          'Updated blog post "My New Operating System for Work": rewrote intro, added accountability/metrics layer section, removed structural rule section, added fortnightly review cadence, linked Obsidian and SimpleNote, added V1 note',
        ],
      },
    ],
  },
  {
    date: '2026-05-19',
    version: '1.1.0',
    title: 'New blog post',
    changes: [
      {
        category: 'Content',
        items: [
          'Published blog post: "My New Operating System for Work"',
        ],
      },
    ],
  },
  {
    date: '2026-05-19',
    version: '1.0.0',
    title: 'Changelog created',
    changes: [
      {
        category: 'Meta',
        items: [
          'Changelog page created to track all future updates to the site',
        ],
      },
    ],
  },
];
---

<BaseLayout title="Changelog" description="A log of updates and changes made to GrowthToDo.com." sideBarActiveItemID="changelog">
  <div class="max-w-3xl mx-auto py-16">
    <h1 class="text-3xl font-bold mb-2">Changelog</h1>
    <p class="text-gray-500 mb-12">All updates to GrowthToDo.com, most recent first.</p>

    <div class="space-y-12">
      {changelog.map((entry) => (
        <div class="border-l-2 border-gray-200 pl-6">
          <div class="flex items-baseline gap-3 mb-1">
            <span class="text-sm text-gray-400">{entry.date}</span>
            <span class="text-xs font-mono bg-gray-100 px-2 py-0.5 rounded">v{entry.version}</span>
          </div>
          <h2 class="text-lg font-semibold mb-4">{entry.title}</h2>
          {entry.changes.map((group) => (
            <div class="mb-4">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">{group.category}</h3>
              <ul class="space-y-1">
                {group.items.map((item) => (
                  <li class="text-sm text-gray-600">
                    {typeof item === 'string' ? (
                      <span>— {item}</span>
                    ) : (
                      <span>— <a href={item.url} class="underline hover:text-blue-500" target="_blank">{item.text}</a></span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
