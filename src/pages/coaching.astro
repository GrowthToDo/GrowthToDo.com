---
import BaseLayout from "../layouts/BaseLayout.astro";
import UpdatesSignup from "../components/UpdatesSignup.astro";

const BOOK_CALL_LINK = "https://growthtodo.neetocal.com/30mins";
const CONTACT_LINK = "mailto:gautham@growthtodo.com";

const academyPrograms = [
  {
    title: "Reverse Engineer Product-Market Fit",
    desc: "A practical workshop for founders to identify the real bottleneck, define the buyer + promise, and leave with a tight execution plan.",
    badge: "READY",
    url: "/coaching",
  },
  {
    title: "Design a Cohort-Based Course",
    desc: "A practical program: design the curriculum, learning cadence, projects, and outcomes for a course people actually finish.",
    badge: "READY",
    url: "https://maven.com/theseconddesign/designacbc",
  },
  {
    title: "Online Course Creation Kickstarter",
    desc: "A fast-start workshop to go from idea to outline to first module to launch plan, without perfectionism.",
    badge: "READY",
    url: "https://maven.com/theseconddesign/online-course-kickstarter",
  },
];

const engagements = [
  {
    title: "Clarity Sprint",
    badge: "START HERE",
    duration: "60-90 min",
    desc: "One working session. We diagnose what is actually stuck, cut through the noise, and build a sequenced action plan for the next 2-4 weeks.",
    outcome: "You leave with a prioritized to-do list you can execute immediately.",
  },
  {
    title: "PMF Deep Dive",
    badge: "WORKSHOP",
    duration: "90-120 min",
    desc: "For founders with unclear demand signals. We pressure test your ICP, offer, and distribution. You walk away with testable hypotheses and your next 3 experiments.",
    outcome: "A PMF scorecard and a clear path to validate or pivot.",
  },
  {
    title: "4-Week Execution",
    badge: "FOLLOW-UP",
    duration: "4 weeks",
    desc: "Weekly cadence to ship the plan with momentum. Planning, review, decision support, and accountability without theatre.",
    outcome: "The plan actually gets done. Momentum compounds.",
  },
];

const testimonials = [
  {
    name: "Abhishek Bose",
    title: "Founder",
    date: "October 2024",
    linkedin: "https://www.linkedin.com/in/abhishekbose87/",
    quote: "If you are on the fence about hiring Gautham as your coach/mentor, trust me, he can point out something in a 30 min call that might take you the next 1 year to figure out.",
    detail: "I was in a rut, feeling a bit confused, and that's when I reached out to Gautham for coaching. After a couple of calls with him, I gained a lot of clarity and confidence. The biggest breakthrough came when I was able to identify my needs with Gautham's help and the exercise he suggested. This process made me more self-aware, allowing me to develop a plan for the next three months. I am also grateful to Gautham for sharing his framework (where he breaks goals into different layers) which helped me to identify the areas that need more work. For eg. I realised how important emotional resilience is and how it can impact my odds of success."
  },
  {
    name: "Ajay Jaykrishnan",
    title: "Coaching Company Founder",
    date: "January 2023",
    linkedin: "https://www.linkedin.com/in/ajay-k-a06396160/",
    quote: "I highly recommend Gautham as a business coach who can take your venture from infancy to growth stage. I have known him for 30+ years and can vouch for his integrity and workmanship.",
    detail: "From the very first session to scale my coaching company, Gautham provided me with a clear and sane direction for my business, helping me think several steps ahead. One of the things that stood out to me is his ability to break down complex strategies into easy-to-follow, actionable steps. This is invaluable if you are a first-time entrepreneur. He took the time to explain everything in detail, which made it much easier for me to understand what I needed to do and why it was important. Gautham's practical experience in navigating regulatory processes is of tremendous value, especially in today's business environment. What I appreciate most is how he has saved me a ton of time, energy, and most importantly, money. Instead of learning through costly mistakes, I was able to avoid many pitfalls and hit my business goals much faster than I expected."
  },
  {
    name: "Andre Schaffer",
    title: "First-time Founder",
    date: "December 2024",
    linkedin: "https://www.linkedin.com/in/andreschaffer/",
    quote: "He helped me prioritize demand over infrastructure early. Saved months of unnecessary work and prevented wasted spend.",
    detail: "As a first-time founder, I believed the key to solving any problem was building the most advanced and cutting-edge infrastructure possible. I paid little attention to generating demand early on, which made acquiring new customers nearly impossible. Meeting Gautham, however, was transformative. Drawing from his extensive business experience, he helped me understand the crucial importance of prioritising demand over infrastructure in the early days of a venture. His insights showed me how focusing on demand first can validate a business model, save months of unnecessary work, and prevent wasting thousands of dollars. Gautham's coaching style represents a symbiosis of guidance, reflection, and empowerment. His unique combination of kindness, attentive listening, perseverance, and extensive expertise fosters a supportive environment for both personal and professional growth."
  },
  {
    name: "Saishree Bandekar",
    title: "Founder, Purple Bakehouse",
    date: "December 2024",
    linkedin: "https://www.linkedin.com/in/saishree-bandekar-6017b2256/",
    quote: "He helped me get to the root of my problems and made intimidating things feel learnable. The mindset shift in one hour was essential.",
    detail: "I've spoken to business coaches and career counselors before, but they mostly gave generic advice or templates that didn't align with my specific situation or thought process. That's where my conversation with Gautham from The Second Design was different. What started as a casual chat turned into a deeply insightful conversation that shifted my perspective on business. Instead of bombarding me with ideas or solutions, Gautham patiently helped me get to the root of my problems, validated my struggles, and supported my ideas with kindness and empathy. Gautham made me realize that the things intimidating me weren't insurmountable it was simply the unfamiliarity that made them daunting. He helped me believe that these skills can be learned and that anyone can become a good businessperson with the right guidance and mindset."
  },
  {
    name: "Pradeep Pandey",
    title: "Product Builder",
    date: "December 2024",
    linkedin: "https://www.linkedin.com/in/pradeep-pandeyji/",
    quote: "When most mentors say I'll help you, they mean a few casual coffee chats. Gautham transformed my entire approach to product development in 3 days.",
    detail: "Before working with him, I had scattered ideas and no clear execution path. He introduced me to a structured framework that turned my product concept from vague thoughts into actionable steps. But their impact went beyond just product strategy. He pushed me to start writing consistently - a habit that has dramatically improved how I think about and communicate my ideas. The most valuable part? His ability to ask the right questions. Each conversation helped me gain more clarity about what I truly wanted to build and why. If you're looking for a mentor/coach who combines practical product expertise with genuine investment in your growth, Gautham is that rare find. He don't just guide - he help you build better thinking habits that last."
  },
  {
    name: "Sushma Teja",
    title: "Team Member",
    date: "July 2024",
    linkedin: "https://www.linkedin.com/in/sushma-kamala-teja-9162417b/",
    quote: "He is more than a mentor he's a true friend and guide who helped me bring clarity to my scattered thoughts and ideas.",
    detail: "I always heard of people having mentors at work, but I never truly experienced it until I met Gautham. With his constant support and encouragement, I learned how to organize my thoughts, put them into writing, and gain a clear direction for both my personal growth and the growth of my company. Gautham introduced me to the habit of writing down my thoughts and opinions, a simple practice that turned out to be incredibly powerful. It helped me break down complex problems and approach tasks with a clear plan. When I joined the company, everything felt new and unfamiliar. I was hesitant and unsure about asking questions, but Gautham created a safe space where no question was too silly or too small. Gautham has a unique way of identifying your potential and pushing you out of your comfort zone. He helps you realize your own capabilities, which is a transformative experience."
  },
]

const steps = [
  { num: "01", title: "Share context", desc: "A short note on what you are building, current traction, and what feels stuck." },
  { num: "02", title: "Working session", desc: "We diagnose, challenge assumptions, and find the root cause together." },
  { num: "03", title: "Walk away with a plan", desc: "A prioritized, sequenced to-do list. Not a PDF. Something you can execute." },
];

const principles = [
  { label: "NO FLUFF", desc: "Zero motivational speak. Zero generic frameworks. Only decisions you can act on today." },
  { label: "NO THEATRE", desc: "No slide decks you will never open. You leave with artifacts: plans, scorecards, execution lists." },
  { label: "NO THEORY", desc: "Built from 15+ years shipping products, not case studies. Real scars, real patterns, real truth." },
];
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title="Coaching" sideBarActiveItemID="coaching">
  <!-- HERO -->
  <section class="py-12 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10">
    <div class="space-y-6 max-w-5xl">
      <div class="inline-flex items-center bg-teal-50 px-3 py-1.5 rounded-full">
        <span class="text-xs font-sans font-semibold text-teal-700 tracking-wide">CONSULTING</span>
      </div>

      <h1 class="font-serif text-5xl md:text-7xl font-bold leading-tight tracking-tight text-base-content">
        Cut through <span class="text-teal-600 font-normal">the</span> chaos.
      </h1>

      <p class="font-serif text-xl md:text-2xl text-base-content/70 max-w-3xl leading-relaxed">
        You know the business. You know the market. But somewhere between strategy and execution, things get stuck. I help founders cut through noise and turn clarity into a sequenced to-do list that actually moves the needle.
      </p>

      <div class="flex flex-wrap gap-4 pt-6">
        <a
          class="group inline-block px-8 py-3.5 bg-base-content text-base-100 font-sans text-sm font-semibold rounded-lg hover:opacity-80 transition-opacity duration-200"
          href={BOOK_CALL_LINK}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
          <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a
          class="inline-block px-8 py-3.5 text-base-content font-sans text-sm font-semibold rounded-lg border-2 border-base-content/25 hover:border-base-content transition-colors duration-200 underline-offset-4"
          href={CONTACT_LINK}
        >
          Ask a question
        </a>
      </div>

      <p class="text-sm font-mono text-base-content/50 pt-4 tracking-[0.1em] leading-loose">
        BEST FIT: SaaS, D2C, education, content, info-products<br/>
        NOT A FIT: offline businesses or fundraising intros
      </p>
    </div>
  </section>

  <!-- SPLIT COMPARISON - White/Beige Split -->
  <section class="grid md:grid-cols-2 gap-0 border-y border-solid border-base-content/10">
    <div class="bg-white p-8 md:p-12 border-r border-base-content/10">
      <div class="text-xs font-sans font-semibold text-teal-600 uppercase tracking-widest mb-5">TRADITIONAL COACHING</div>
      <h3 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-base-content leading-tight">Theory and theatre</h3>
      <ul class="space-y-4 font-serif text-lg text-base-content/70">
        <li class="flex items-start gap-3">
          <span class="text-red-600 mt-1">×</span>
          <span>Generic frameworks copied from MBA textbooks</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-600 mt-1">×</span>
          <span>Slide decks you will never open again</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-600 mt-1">×</span>
          <span>High-level strategy with no execution plan</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-600 mt-1">×</span>
          <span>Expensive retainers with slow turnaround</span>
        </li>
      </ul>
    </div>
    <div class="bg-base-200 p-8 md:p-12">
      <div class="text-xs font-sans font-semibold text-teal-600 uppercase tracking-widest mb-5">MY APPROACH</div>
      <h3 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-base-content leading-tight">Clarity and execution</h3>
      <ul class="space-y-4 font-serif text-lg text-base-content/70">
        <li class="flex items-start gap-3">
          <span class="text-green-600 mt-1">✓</span>
          <span>Built from shipping real products for 15+ years</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-green-600 mt-1">✓</span>
          <span>Actionable artifacts: plans, scorecards, experiments</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-green-600 mt-1">✓</span>
          <span>Sequenced to-do lists you can execute today</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-green-600 mt-1">✓</span>
          <span>Fast turnaround, no retainer lock-in</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="bg-base-300 py-12 md:py-12 border-y border-solid border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="text-xs font-sans font-semibold text-teal-600 uppercase tracking-widest mb-6">PROCESS</div>
      <h2 class="font-serif text-5xl md:text-6xl font-bold mb-12 text-base-content leading-tight">How it works</h2>

      <div class="grid md:grid-cols-3 gap-0 border border-base-content/10">
        {steps.map((step) => (
          <div class="group border-r last:border-r-0 border-b md:border-b-0 border-base-content/10 p-10 md:p-12 min-h-[320px] bg-white hover:bg-base-200 transition-colors duration-200">
            <div class="font-mono text-xs uppercase tracking-[0.2em] text-current opacity-50 mb-6">{step.num}</div>
            <h3 class="font-serif text-3xl md:text-4xl font-bold mb-5 text-current leading-tight">{step.title}</h3>
            <p class="font-serif text-lg text-current opacity-80 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MANIFESTO - Dark Section -->
  <section class="bg-[#292524] text-white py-12 md:py-12 border-y border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="rounded-2xl border border-white/20 p-10 max-w-5xl">
        <div class="font-mono text-xs uppercase tracking-[0.2em] text-white/50 mb-8">WHY THIS MATTERS</div>
        <blockquote class="font-serif text-4xl md:text-5xl italic font-light leading-relaxed text-white/95 mb-8">
          "Most founders do not lack ideas. They lack clarity on what to do next, in what order, and why it matters. I help you cut through analysis paralysis and turn strategy into a sequenced execution plan."
        </blockquote>
        <div class="font-serif text-xl text-white/70 pt-6 border-t border-white/10">
          After building and scaling products for 15+ years from cohort-based courses to healthcare SaaS I have seen what actually works. Not theory. Not best practices from Silicon Valley newsletters. Real patterns from real execution.
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="bg-base-200 py-12 md:py-12 border-y border-solid border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="text-xs font-sans font-semibold text-teal-600 uppercase tracking-widest mb-6">FOUNDER FEEDBACK</div>
      <h2 class="font-serif text-5xl md:text-6xl font-bold mb-12 text-base-content leading-tight">What founders say</h2>

      <div class="space-y-6">
        {testimonials.map((t) => (
          <div class="bg-white border border-base-content/10 p-8 md:p-10">
            <blockquote class="font-serif text-xl md:text-2xl italic leading-relaxed text-base-content/90 mb-6">
              "{t.quote}"
            </blockquote>
            <p class="font-serif text-base md:text-lg text-base-content/70 leading-relaxed mb-6">
              {t.detail}
            </p>
            <div class="pt-6 border-t border-base-content/10 flex items-center justify-between flex-wrap gap-4">
              <div>
                <a
                  href={t.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-serif font-bold text-base-content text-lg hover:opacity-70 transition-opacity inline-flex items-center gap-2"
                >
                  {t.name}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                </a>
                <div class="font-sans text-xs text-base-content/50 mt-1">{t.title}</div>
              </div>
              <div class="font-sans text-xs text-base-content/50">{t.date}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TURPENTINE ACADEMY -->
  <section class="py-12 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10">
    <div class="text-xs font-sans font-semibold text-teal-600 uppercase tracking-widest mb-4">Workshops</div>
    <h2 class="font-serif text-4xl md:text-5xl font-bold text-base-content leading-tight mb-3">Turpentine Academy</h2>
    <p class="font-serif text-lg text-base-content/60 max-w-xl mb-10">These are workshops I've already built. Ready to go. You can book them as-is, or request a private run for your team.</p>

    <div class="rounded-xl bg-base-200 p-8 max-w-3xl mb-10">
      <blockquote class="font-serif text-lg md:text-xl italic text-base-content/90 leading-relaxed">
        "When art critics get together they talk about Form and Structure and Meaning. When artists get together they talk about where you can buy cheap turpentine."
      </blockquote>
      <p class="font-sans text-xs text-base-content/50 mt-4">Pablo Picasso</p>
    </div>

    <div class="border-t border-base-content/10 mb-10">
      {academyPrograms.map((p) => (
        <a
          href={p.url}
          class="group flex items-start justify-between border-b border-base-content/10 py-8 hover:bg-base-200 transition-colors duration-200"
        >
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="font-serif text-2xl md:text-3xl font-bold text-base-content">{p.title}</h3>
              <span class="text-xs font-sans font-semibold px-2.5 py-1 rounded-full border border-base-content/30 text-base-content/60">{p.badge}</span>
            </div>
            <p class="font-serif text-lg text-base-content/70 leading-relaxed max-w-2xl">{p.desc}</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-base-content group-hover:translate-x-1 transition-all flex-shrink-0 ml-6 mt-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </div>

  </section>

  <!-- FINAL CTA - Beige Background -->
  <section class="bg-base-300 py-12 md:py-12 border-y border-solid border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-4xl">
        <h2 class="font-serif text-4xl md:text-5xl font-bold mb-6 text-base-content leading-tight">
          Ready to <span class="text-teal-600 font-normal">get</span> unstuck?
        </h2>
        <p class="font-serif text-lg md:text-xl text-base-content/70 mb-8 leading-relaxed">
          Book a call. Share what you are building, what is working, and what feels stuck. I will tell you if I can help and what the best first step is.
        </p>

        <a
          class="group inline-block px-10 py-4 bg-base-content text-base-100 font-sans text-sm font-semibold rounded-lg hover:opacity-80 transition-opacity duration-200"
          href={BOOK_CALL_LINK}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
          <span class="inline-block ml-2 group-hover:scale-110 transition-transform">→</span>
        </a>

        <div class="mt-16 p-8 border border-base-content/20 bg-white">
          <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-4">WHAT TO SEND</div>
          <p class="font-serif text-lg text-base-content/80 leading-relaxed">
            If you send 5 lines with: <strong>what you sell</strong>, <strong>who you sell to</strong>, <strong>current traction</strong>, <strong>what is stuck</strong>, and <strong>what you have tried</strong>, I can be decisive fast.
          </p>
        </div>

        <div class="mt-8 max-w-2xl">
          <UpdatesSignup source="coaching" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
</div>
