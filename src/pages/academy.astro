---
import BaseLayout from "../layouts/BaseLayout.astro";

const BOOK_CALL_LINK = "https://growthtodo.neetocal.com/30mins";

const programs = [
  {
    title: "Reverse Engineer Product-Market Fit",
    desc: "A practical workshop for founders to identify the real bottleneck, define the buyer + promise, and leave with a tight execution plan.",
    badge: "READY",
    url: "/consulting",
  },
  {
    title: "Performance Marketing for the Indian Market",
    desc: "A founder-friendly course on running ads with clarity: offers, landing pages, measurement, creatives, and iteration. Tailored to India.",
    badge: "COMING SOON",
    url: "#",
  },
];

const secondDesignPrograms = [
  {
    title: "Design Your Own Code-Based Course",
    desc: "A practical program: design the curriculum, learning cadence, projects, and outcomes for a course people actually finish.",
    url: "https://theseconddesign.com",
  },
  {
    title: "Online Course Creation Kickstarter",
    desc: "A fast-start workshop to go from idea to outline to first module to launch plan, without perfectionism.",
    url: "https://theseconddesign.com",
  },
];

const principles = [
  { label: "LESS THEORY THEATRE", desc: "Fewer frameworks-for-the-sake-of-it. More decisions you can act on." },
  { label: "MORE REAL CRAFT", desc: "Tools, constraints, distribution, shipping. The unglamorous truth." },
  { label: "WORKSHOPS YOU USE", desc: "You leave with artifacts: plans, scorecards, experiments. Not vibes." },
];
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title="Academy" sideBarActiveItemID="academy">
  <!-- HERO -->
  <section class="py-12 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-dashed border-base-content/10">
    <div class="space-y-4 max-w-5xl">
      <div class="inline-block border border-base-content/10 px-3 py-1.5">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/70">ACADEMY</span>
      </div>

      <h1 class="font-serif text-5xl md:text-7xl font-bold leading-[0.85] tracking-tight text-base-content">
        Turpentine <span class="italic font-light">Academy.</span>
      </h1>

      <!-- Quote -->
      <div class="border-l-4 border-base-content/20 bg-[#f9f9f7] p-8 max-w-3xl">
        <blockquote class="font-serif text-xl md:text-2xl italic text-base-content/90 leading-relaxed">
          "When art critics get together they talk about Form and Structure and Meaning. When artists get together they talk about where you can buy cheap turpentine."
        </blockquote>
        <p class="font-mono text-xs text-base-content/50 mt-6 tracking-[0.1em]">— PABLO PICASSO</p>
      </div>

      <div class="flex flex-wrap gap-4 pt-4">
        <a
          class="group inline-block px-8 py-4 bg-base-content text-base-100 font-mono text-sm uppercase tracking-[0.2em] border border-base-content shadow-[4px_4px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_#272048] transition-all duration-300"
          href={BOOK_CALL_LINK}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
          <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a
          class="inline-block px-8 py-4 bg-base-100 text-base-content font-mono text-sm uppercase tracking-[0.2em] border border-base-content shadow-[4px_4px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_#272048] transition-all duration-300"
          href="/blog"
        >
          Read the blog
        </a>
      </div>

      <p class="text-sm font-mono text-base-content/50 pt-4 tracking-[0.1em] leading-loose">
        FOR BUILDERS WHO WANT CLARITY + EXECUTION.<br/>NOT FOR PEOPLE LOOKING FOR GENERIC CONTENT.
      </p>
    </div>
  </section>

  <!-- PRINCIPLES -->
  <section class="bg-[#f0f0eb] py-12 md:py-12 border-y border-dashed border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-8">FIGURE 01: PHILOSOPHY</div>

      <div class="space-y-6 max-w-4xl">
        {principles.map((p) => (
          <div class="border-l-4 border-base-content bg-white p-8">
            <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-3">{p.label}</div>
            <div class="font-serif text-xl text-base-content/90">{p.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="py-12 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-dashed border-base-content/10">
    <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-8">FIGURE 02: PROGRAMS</div>
    <h2 class="font-serif text-4xl md:text-5xl font-bold mb-8 text-base-content leading-[0.85]">
      Programs <span class="italic font-light">&</span> workshops
    </h2>

    <div class="border-t border-base-content/10">
      {programs.map((p) => (
        <a
          href={p.url}
          class="group block border-b border-base-content/10 py-10 md:py-12 hover:bg-base-content hover:text-white hover:-mx-12 hover:px-12 transition-all duration-500"
        >
          <div class="space-y-4">
            <div class="flex flex-wrap items-center gap-4">
              <h3 class="font-serif text-3xl md:text-4xl font-bold text-current">{p.title}</h3>
              <span class="font-mono text-xs uppercase tracking-[0.2em] px-3 py-2 bg-current text-white group-hover:bg-white group-hover:text-base-content transition-all">{p.badge}</span>
            </div>
            <p class="font-serif text-lg md:text-xl text-current opacity-80 leading-relaxed max-w-3xl">{p.desc}</p>
          </div>
        </a>
      ))}
    </div>

    <p class="font-mono text-sm text-base-content/50 mt-12 tracking-[0.1em]">
      Want early access to upcoming programs? Book a call and tell me what you are building.
    </p>
  </section>

  <!-- SECOND DESIGN -->
  <section class="bg-[#f9f9f7] py-12 md:py-12 border-y border-dashed border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="border border-base-content/20 bg-white p-8 mb-12 max-w-3xl">
        <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-3">ALSO AVAILABLE ELSEWHERE</div>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-base-content mb-3">From The Second Design</h2>
        <p class="font-serif text-base-content/70">These programs are already live under The Second Design. You will be leaving GrowthToDo.</p>
      </div>

      <div class="border-t border-base-content/10">
        {secondDesignPrograms.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between border-b border-base-content/10 py-8 hover:bg-base-content hover:text-white hover:-mx-12 hover:px-12 transition-all duration-500"
          >
            <div class="flex-grow">
              <h3 class="font-serif text-xl md:text-2xl font-bold text-current mb-2">{p.title}</h3>
              <p class="font-serif text-lg text-current opacity-80">{p.desc}</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-current opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all flex-shrink-0 ml-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-12 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-dashed border-base-content/10">
    <div class="max-w-4xl">
      <h2 class="font-serif text-5xl md:text-6xl font-bold mb-8 text-base-content leading-[0.85]">
        Want a <span class="italic font-light">private run</span> for your team?
      </h2>
      <p class="font-serif text-xl md:text-2xl text-base-content/70 mb-10 leading-relaxed">
        Do not overthink it. Email context and I will tell you what fits, what does not, and the fastest starting point.
      </p>

      <a
        class="group inline-block px-10 py-4 bg-base-content text-base-100 font-mono text-sm uppercase tracking-[0.2em] border border-base-content shadow-[6px_6px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[4px_4px_0px_0px_#272048] transition-all duration-300"
        href={BOOK_CALL_LINK}
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a call
        <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
</div>
