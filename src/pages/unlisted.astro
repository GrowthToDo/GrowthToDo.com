---
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
  { label: "Founder OS", href: "/founder-os" },
  { label: "AI Unconference", href: "/ai-unconference" },
  { label: "Store", href: "/store" },
  { label: "Changelog", href: "/changelog" },
  { label: "Rent Calculator", href: "/rent-calculator" },
  { label: "SkyConnect", href: "/skyconnect/" },
  { label: "SkyConnect — Prototype", href: "/skyconnect/prototype/" },
  { label: "SkyConnect — Case study", href: "/skyconnect/case-study/" },
  { label: "SkyConnect — Pitch deck", href: "/skyconnect/slides/" },
  { label: "SkyConnect — Speaker notes", href: "/skyconnect/speaker-notes/" },
];
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout sideBarActiveItemID="unlisted">

  <section class="py-6 md:py-20 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10 md:min-h-screen md:flex md:flex-col md:justify-center">
    <div class="space-y-8 md:space-y-10 max-w-2xl">

      <h1 class="font-serif text-2xl md:text-3xl font-normal leading-snug tracking-tight text-base-content/80">
        Pages that aren't in the <span class="text-teal-600 font-normal">menu.</span>
      </h1>

      <ul class="space-y-2 list-disc list-inside marker:text-teal-500 marker:text-lg">
        {links.map((link) => (
          <li class="font-serif text-xl text-base-content">
            <a href={link.href} class="text-teal-600 hover:underline">{link.label}</a>
          </li>
        ))}
      </ul>

    </div>
  </section>

</BaseLayout>
</div>
