---
import BaseLayout from "../layouts/BaseLayout.astro";
import UpdatesSignup from "../components/UpdatesSignup.astro";

const BOOK_CALL_LINK = "https://growthtodo.neetocal.com/30mins";

type TimelineItem = {
  id: string;
  years: string;
  org: string;
  role: string;
  location?: string;
  url?: string;
  highlights: string[];
  links?: { label: string; href: string }[];
  isNow?: boolean;
};

const timeline: TimelineItem[] = [
  {
    id: "simplescheduleai",
    years: "Apr 2026 - Present",
    org: "SimpleScheduleAI",
    role: "Co-founder",
    url: "https://simplescheduleai.com",
    isNow: true,
    highlights: [
      "Building a scheduling tool for US hospitals to reduce operational chaos, overtime, and burnout.",
    ],
  },
  {
    id: "sellontube",
    years: "Dec 2025 - Present",
    org: "SellOnTube",
    role: "Co-founder",
    url: "https://sellontube.com",
    isNow: true,
    highlights: [
      "YouTube-first customer acquisition for internet-first businesses (done-for-you).",
      "Focus: bottom-of-funnel videos, positioning, and repeatable distribution systems.",
    ],
  },
  {
    id: "theseconddesign",
    years: "Sep 2022 - Present",
    org: "The Second Design",
    role: "Co-founder",
    url: "https://theseconddesign.com",
    isNow: true,
    highlights: [
      "An education design studio that designs transformational learning environments: curriculum, cohorts, facilitation, and learning cadence.",
      "Work spans students, professionals, communities, and partner-led programs.",
    ],
  },
  {
    id: "startglobal",
    years: "Sep 2022 - Dec 2025",
    org: "StartGlobal.co",
    role: "COO (focus: user growth)",
    url: "https://startglobal.co",
    highlights: [
      "Scaled team and set up a more professional operating structure.",
      "Learned what scales (and what doesn't) in paid vs. organic growth loops.",
    ],
  },
  {
    id: "howtocbc",
    years: "Jul 2021 - Sep 2022",
    org: "HowToCBC.com",
    role: "Co-founder",
    highlights: [
      "Built deep expertise in cohort-based course creation + distribution realities.",
      "Partnered with multiple CBC platforms; learned internet outreach + marketing.",
    ],
  },
  {
    id: "pupilfirst",
    years: "2019 - 2021",
    org: "Pupilfirst.org",
    role: "Co-founder & Director",
    highlights: [
      "Pivoted from incubation to education (developer school direction).",
      "Built industry-academia partnerships across universities; collaborated with major partners.",
      "Built and open-sourced an LMS; iterated heavily across years of learning models.",
    ],
  },
  {
    id: "svco",
    years: "2015 - 2019",
    org: "SV.CO (Startup Village Collective)",
    role: "Co-founder & COO",
    highlights: [
      "Raised funding to scale a digital incubator platform built at SV Labs.",
      "Incubated 100+ student teams via cohort-style programs across India.",
      "Learned hard lessons about sustainability, business models, and distribution.",
    ],
  },
  {
    id: "svlabs",
    years: "2013 - 2015",
    org: "SV Labs",
    role: "Co-founder & CEO",
    highlights: [
      "Built the digital platform that became the future of the incubator work.",
      "Helped move incubation services from physical-heavy to online-first operations.",
      "Shipped fast, learned faster. Classic builder/operator chapter.",
    ],
  },
  {
    id: "mobme",
    years: "2009 - 2013",
    org: "Mobme",
    role: "Leadership (early team / operator)",
    highlights: [
      "Joined early and wore every hat: biz-dev, ops, sales, strategy, client relations, hiring, growth.",
      "Joined as employee #1 for a new division; grew it into the top revenue vertical.",
      "Learned the cost of missing platform shifts while executing relentlessly.",
    ],
  },
];

const education = [
  {
    title: "Write of Passage (Cohort 8)",
    desc: "Personally invited by David Perell with a 95% scholarship. A writing-first program focused on clarity of thinking. Easily the best educational experience I have been part of.",
  },
  {
    title: "Maven Accelerator Program (Cohort 3)",
    desc: "Cohort of 145 instructors across 27 countries and 100+ cities, selected from 2,000+ applicants. One of the first 75 courses launched on Maven.com in 2021.",
  },
  {
    title: "B.Tech, Applied Electronics & Instrumentation",
    desc: "College of Engineering, Trivandrum (CET), 2009",
  },
];

const skills = [
  {
    label: "OPERATOR SKILLS",
    items: [
      "Breaking complex problems into clear, executable sequences",
      "Hiring, team design, operating cadence, and execution quality",
      "Sales + customer conversations (the unglamorous truth source)",
      "Growth systems: positioning, distribution, iteration loops",
    ],
  },
  {
    label: "BUILDER / EDUCATOR SKILLS",
    items: [
      "Education design: cohorts, curriculum, facilitation, learning environments",
      "Writing-first clarity (thinking, communicating, aligning)",
      "Product thinking: demand, ICP, PMF diagnostics, and ruthless prioritization",
      "Turning messy expertise into teachable, shippable assets",
    ],
  },
];
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title="CV" sideBarActiveItemID="cv">
  <!-- HERO -->
  <section class="py-12 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10">
    <div class="space-y-4 max-w-5xl">
      <div class="inline-flex items-center bg-teal-50 px-3 py-1.5 rounded-full">
        <span class="text-xs font-sans font-semibold text-teal-700 tracking-wide">CV</span>
      </div>

      <h1 class="font-serif text-5xl md:text-7xl font-bold leading-tight tracking-tight text-base-content">
        Founder-<span class="text-teal-600 font-normal">Operator.</span>
      </h1>


      <div class="flex flex-wrap gap-4 pt-6">
        <a
          class="group inline-block px-8 py-3.5 bg-base-content text-base-100 font-sans text-sm font-semibold rounded-lg hover:opacity-80 transition-opacity duration-200"
          href={BOOK_CALL_LINK}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
          <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a
          class="inline-block px-8 py-3.5 text-base-content font-sans text-sm font-semibold rounded-lg border-2 border-base-content/25 hover:border-base-content transition-colors duration-200"
          href="/work"
        >
          View projects
        </a>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section class="bg-base-300 py-12 md:py-12 border-y border-solid border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="text-xs font-sans font-semibold text-teal-600 uppercase tracking-widest mb-6">SKILLS</div>

      <div class="space-y-6 max-w-4xl">
        {skills.map((skill) => (
          <div class="rounded-xl bg-white p-8 border border-base-content/10 shadow-sm">
            <div class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/50 mb-4">{skill.label}</div>
            <ul class="space-y-2">
              {skill.items.map((item) => (
                <li class="font-serif text-lg text-base-content/90 leading-relaxed">• {item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="py-12 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10">
    <div class="text-xs font-sans font-semibold text-teal-600 uppercase tracking-widest mb-6">TIMELINE</div>
    <h2 class="font-serif text-4xl md:text-5xl font-bold mb-8 text-base-content leading-tight">
      Work <span class="text-teal-600 font-normal">history</span>
    </h2>

    <div class="border-t border-base-content/10">
      {timeline.map((item) => (
        <div class="group border-b border-base-content/10 py-10 md:py-12 hover:bg-base-200 transition-colors duration-200">
          <div class="flex flex-col md:flex-row md:items-start gap-6">
            <div class="md:w-48 flex-shrink-0">
              <div class="font-mono text-xs text-current opacity-50 group-hover:opacity-100 tracking-[0.1em]">{item.years}</div>
              {item.isNow && (
                <span class="inline-block font-mono text-xs uppercase tracking-[0.2em] px-2 py-1 bg-teal-600 text-white mt-2">NOW</span>
              )}
            </div>

            <div class="flex-grow">
              <div class="mb-3">
                <h3 class="font-serif text-3xl md:text-4xl font-bold text-current mb-2">
                  {item.url ? (
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity">
                      {item.org}
                    </a>
                  ) : (
                    item.org
                  )}
                </h3>
                <div class="font-serif text-lg text-current opacity-70">{item.role}</div>
              </div>

              <ul class="space-y-2">
                {item.highlights.map((h) => (
                  <li class="font-serif text-lg text-current opacity-80 leading-relaxed">• {h}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="bg-base-200 py-12 md:py-12 border-y border-solid border-base-content/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="text-xs font-sans font-semibold text-teal-600 uppercase tracking-widest mb-6">EDUCATION</div>
      <h2 class="font-serif text-4xl md:text-5xl font-bold mb-8 text-base-content leading-tight">
        Education <span class="text-teal-600 font-normal">&</span> programs
      </h2>

      <div class="border-t border-base-content/10">
        {education.map((e) => (
          <div class="border-b border-base-content/10 py-8 md:py-10 bg-transparent hover:bg-white hover:-mx-12 hover:px-12 transition-all duration-300">
            <h3 class="font-serif text-xl md:text-2xl font-bold text-base-content mb-3">{e.title}</h3>
            <p class="font-serif text-lg text-base-content/70 leading-relaxed max-w-3xl">{e.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-12 md:py-12 max-w-7xl mx-auto px-6 md:px-12 border-x border-solid border-base-content/10">
    <div class="max-w-4xl">
      <h2 class="font-serif text-5xl md:text-6xl font-bold mb-8 text-base-content leading-tight">
        Want to work <span class="text-teal-600 font-normal">together?</span>
      </h2>

      <a
        class="group inline-block px-10 py-4 bg-base-content text-base-100 font-sans text-sm font-semibold rounded-lg hover:opacity-80 transition-opacity duration-200"
        href={BOOK_CALL_LINK}
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a call
        <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
      </a>

      <div class="mt-10 max-w-2xl">
        <UpdatesSignup source="cv" />
      </div>
    </div>
  </section>
</BaseLayout>
</div>
