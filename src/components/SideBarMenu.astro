---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "active-nav-item"; // active item highlight
---

<ul class="menu grow shrink menu-md overflow-y-auto gap-1">
  <li>
    <a class="nav-item py-2.5 px-3 text-base font-serif rounded-lg text-base-content hover:text-base-content hover:bg-base-300/50 transition-all duration-200" id="home" href="/">Home</a>
  </li>

  <li>
    <a class="nav-item py-2.5 px-3 text-base font-serif rounded-lg text-base-content hover:text-base-content hover:bg-base-300/50 transition-all duration-200" id="consulting" href="/consulting">Consulting</a>
  </li>

  <li>
    <a class="nav-item py-2.5 px-3 text-base font-serif rounded-lg text-base-content hover:text-base-content hover:bg-base-300/50 transition-all duration-200" id="projects" href="/projects">Projects</a>
  </li>

  <li>
    <a class="nav-item py-2.5 px-3 text-base font-serif rounded-lg text-base-content hover:text-base-content hover:bg-base-300/50 transition-all duration-200" id="blog" href="/blog/">Blog</a>
  </li>

  <li>
    <a class="nav-item py-2.5 px-3 text-base font-serif rounded-lg text-base-content hover:text-base-content hover:bg-base-300/50 transition-all duration-200" id="academy" href="/academy">Academy</a>
  </li>

  <li>
    <a class="nav-item py-2.5 px-3 text-base font-serif rounded-lg text-base-content hover:text-base-content hover:bg-base-300/50 transition-all duration-200" id="cv" href="/cv">CV</a>
  </li>

  <li>
    <a class="nav-item py-2.5 px-3 text-base font-serif rounded-lg text-base-content hover:text-base-content hover:bg-base-300/50 transition-all duration-200" id="testimonials" href="/testimonials">Testimonials</a>
  </li>

  <li>
    <a
      class="nav-item py-2.5 px-3 text-base font-serif rounded-lg text-base-content hover:text-base-content hover:bg-base-300/50 transition-all duration-200"
      href="mailto:gautham@growthtodo.com"
      target="_blank"
      referrerpolicy="no-referrer-when-downgrade"
    >
      Contact
    </a>
  </li>
</ul>

<style>
  .active-nav-item {
    background: #272048 !important;
    color: #ffffff !important;
  }
</style>

<script define:vars={{ sideBarActiveItemID, activeClass }}>
  const activeItemElem = document.getElementById(sideBarActiveItemID);
  activeItemElem && activeItemElem.classList.add(activeClass);
</script>