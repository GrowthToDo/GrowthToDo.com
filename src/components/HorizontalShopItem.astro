---
const {
  title,
  img,
  desc,
  url,
  badge,
  pricing,
  oldPricing,
} = Astro.props;
import { Image } from "astro:assets";
---

<li class="py-6 first:pt-0">
  <a href={url} class="group flex flex-col md:flex-row gap-5 items-start">
    {
      img && (
        <Image
          width={750}
          height={422}
          format="webp"
          src={img}
          alt={title}
          class="w-full md:w-48 shrink-0 rounded-lg border border-base-content/10"
        />
      )
    }
    <div class="grow">
      <h2 class="font-serif text-xl md:text-2xl font-bold text-base-content group-hover:text-teal-600 transition-colors">
        {title}
        {badge && (
          <span class="ml-2 inline-block font-sans text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200 align-middle relative -top-0.5">
            {badge}
          </span>
        )}
      </h2>
      <div class="mt-1 font-sans">
        <span class="text-lg text-base-content mr-1">{pricing}</span>
        <span class="text-sm text-base-content/40 line-through">{oldPricing}</span>
      </div>
      <p class="mt-2 font-serif text-base text-base-content/70 leading-relaxed">{desc}</p>
    </div>
  </a>
</li>
