---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends BlogSchema {}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");

const isExternalImage = typeof heroImage === 'string' && heroImage.startsWith('http');
---

<div data-theme="cogniswitch" class="min-h-screen bg-base-100">
<BaseLayout title={title} description={description} image={heroImage} ogType="article">
  <main class="py-12 md:py-16 max-w-7xl mx-auto px-6 md:px-12 border-x border-dashed border-base-content/10">
    <article class="prose prose-lg max-w-[750px] mx-auto prose-img:mx-auto prose-headings:font-serif prose-headings:text-base-content prose-p:font-serif prose-p:text-base-content/80 prose-li:font-serif prose-li:text-base-content/80 prose-strong:text-base-content prose-a:text-base-content prose-a:underline hover:prose-a:opacity-70">
      <!-- Hero image -->
      {heroImage && (
        <div class="overflow-hidden mb-12 -mx-4 md:mx-0 border border-base-content/10">
          <img
            src={heroImage}
            alt={title}
            class="w-full h-auto object-cover !my-0"
            loading="eager"
          />
        </div>
      )}

      <!-- Title -->
      <h1 class="font-serif !text-5xl md:!text-6xl font-bold !mb-8 !mt-0 !leading-[0.95]">{title}</h1>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-3 !mb-10 not-prose">
        {pubDate && (
          <span class="font-mono text-xs text-base-content/50 tracking-[0.1em]">{displayDate}</span>
        )}
        {badge && (
          <span class="font-mono text-xs uppercase tracking-[0.2em] px-2 py-1 bg-base-content text-white">{badge}</span>
        )}
        {tags?.map((tag) => (
          <a href={`/blog/tag/${tag}`} class="font-mono text-xs uppercase tracking-[0.1em] px-2 py-1 border border-base-content/20 hover:bg-base-content hover:text-white transition-all">
            {tag}
          </a>
        ))}
      </div>

      {updatedDate && (
        <p class="font-mono text-xs text-base-content/50 !mb-8 tracking-[0.1em]">
          Last updated on {dayjs(updatedDate).format("ll")}
        </p>
      )}

      <div class="border-t border-base-content/10 !mb-12"></div>

      <!-- Content -->
      <slot />

      <!-- Back link -->
      <div class="border-t border-base-content/10 !mt-16 !pt-10 not-prose">
        <a
          href="/blog"
          class="inline-block px-6 py-3 bg-base-100 text-base-content font-mono text-xs uppercase tracking-[0.2em] border border-base-content shadow-[3px_3px_0px_0px_#272048] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[1px_1px_0px_0px_#272048] transition-all duration-300"
        >
          ← Back to blog
        </a>
      </div>
    </article>
  </main>
</BaseLayout>
</div>
